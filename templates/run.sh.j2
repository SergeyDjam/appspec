#!/bin/sh
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
set -eu

SPEC_DIR="$(cd "$(dirname "$0")" && pwd)"
SIF_FILE="$SPEC_DIR/{{ sif_file }}"
IMAGE_NAME="{{ image_name }}"
INSTANCE_NAME="{{ pkg.name }}"
{% if runtime.vars %}

# --- user variables ---
{% for k, v in runtime.vars | items -%}
{{ k }}="{{ v }}"
{% endfor -%}
{% endif -%}
{% if runtime.state_dirs %}

# --- state directories on the host ---
{% for d in runtime.state_dirs -%}
mkdir -p "$CONFIG_DIR/{{ d }}"
{% endfor -%}
{% endif -%}
{% if create_dirs %}

# --- create_dirs: каталоги, которые обязаны существовать до bind'а ---
{% for d in create_dirs -%}
mkdir -p {{ d }}
{% endfor -%}
{% endif %}

if [ ! -f "$SIF_FILE" ]; then
    echo "SIF not found: $SIF_FILE" >&2
    echo "Build with: appspec build <spec.toml>" >&2
    exit 1
fi

# --- Детерминированное имя instance. Если уже запущен — не поднимаем
# --- второй раз, иначе apptainer откажется или получится каша из
# --- двух процессов на одном /run/*.pid внутри rootfs.
if apptainer instance list 2>/dev/null \
       | awk 'NR>1 && NF>=1 {print $1}' \
       | grep -qx "$INSTANCE_NAME"; then
    echo "instance '$INSTANCE_NAME' уже запущен" >&2
{% if persist %}
    echo "остановить: appspec stop <spec.toml>" >&2
    exit 0
{% else %}
    echo "остановить: apptainer instance stop $INSTANCE_NAME" >&2
    exit 1
{% endif %}
fi

BINDS=""
{% for line in bind_lines -%}
{{ line }}
{% endfor -%}
{% if xauthority_auto %}

if [ -n "${XAUTHORITY:-}" ]; then
    BINDS="$BINDS --bind $XAUTHORITY:$XAUTHORITY"
fi
{% endif -%}
{% if pulse_auto %}

if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -e "$XDG_RUNTIME_DIR/pulse/native" ]; then
    BINDS="$BINDS --bind $XDG_RUNTIME_DIR/pulse/native:/tmp/pulse-native"
fi
{% endif %}

X_ENV=""
{% for line in env_checks -%}
{{ line }}
{% endfor -%}
{% if xauthority_auto %}

[ -n "${XAUTHORITY:-}" ] && X_ENV="$X_ENV --env XAUTHORITY=$XAUTHORITY" || true
{% endif -%}
{% if pulse_auto %}

[ -e "${XDG_RUNTIME_DIR:-/nonexistent}/pulse/native" ] && \
    X_ENV="$X_ENV --env PULSE_SERVER=unix:/tmp/pulse-native" || true
{% endif %}

apptainer instance start \
    --writable-tmpfs \
    --fakeroot \
    --contain \
    $BINDS \
    "$SIF_FILE" \
    "$INSTANCE_NAME"

{% if not persist %}
# --- Не persist: останавливаем instance, когда лаунчер вернёт управление.
# --- Так работают GUI-приложения: закрыли окно — instance умер.
cleanup() {
    apptainer instance stop "$INSTANCE_NAME" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
{% else %}
# --- persist = true: instance остаётся работать после выхода лаунчера.
# --- Останавливается вручную: appspec stop <spec.toml>.
{% endif %}

apptainer exec $X_ENV \
    --pwd {{ workdir }} \
    "instance://$INSTANCE_NAME" /bin/sh -s <<'{{ heredoc_tag }}'
{% if runtime_setup %}{{ runtime_setup }}
{% endif %}{% if runtime_entry %}{{ runtime_entry }}
{% endif %}{{ heredoc_tag }}
{% if persist %}

echo "=== instance '$INSTANCE_NAME' продолжает работать в фоне ===" >&2
echo "    остановить: appspec stop <spec.toml>" >&2
{% endif %}