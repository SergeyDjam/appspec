#!/bin/sh
# Auto-generated by appspec — launcher for {{ pkg.name }} {{ pkg.version }}
# scope: {{ scope }}
set -eu

SIF="{{ sif_path }}"
SETUP="{{ setup_path }}"
STATE="{{ state_dir }}"

{% if runtime.vars %}
# --- user variables from [runtime.vars] (spec defaults) ---
{% for k, v in runtime.vars | items -%}
{{ k }}="{{ v }}"
{% endfor %}
{% endif %}

# --- install scope: CONFIG_DIR always points to the installer-managed
# --- state directory, regardless of what the spec's [runtime.vars] says.
CONFIG_DIR="$STATE"

if [ ! -f "$SIF" ]; then
    echo "SIF missing: $SIF" >&2
    echo "Reinstall with: appspec install <spec.toml>" >&2
    exit 1
fi

HOME_DIR="$STATE/home"
LOG_DIR="$STATE/log"
mkdir -p "$HOME_DIR/.config" "$HOME_DIR/.local/share" "$HOME_DIR/.cache" "$LOG_DIR"
{% if create_dirs %}
{% for d in create_dirs %}
mkdir -p {{ d }}
{% endfor -%}
{% endif %}

BINDS=""
{% for line in bind_lines -%}
{{ line }}
{% endfor %}

[ -n "${DISPLAY:-}" ] && ENV_PASS="--env DISPLAY=$DISPLAY" || ENV_PASS=""

if [ -n "${XAUTHORITY:-}" ]; then
    BINDS="$BINDS --bind $XAUTHORITY:$XAUTHORITY"
    ENV_PASS="$ENV_PASS --env XAUTHORITY=$XAUTHORITY"
fi

if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -e "$XDG_RUNTIME_DIR/pulse/native" ]; then
    BINDS="$BINDS --bind $XDG_RUNTIME_DIR/pulse/native:/tmp/pulse-native"
    ENV_PASS="$ENV_PASS --env PULSE_SERVER=unix:/tmp/pulse-native"
fi

BINDS="$BINDS --bind $HOME_DIR:/config/home"
BINDS="$BINDS --bind $LOG_DIR:/config/log"
BINDS="$BINDS --bind $SETUP:/setup.sh:ro"

exec apptainer exec \
    --writable-tmpfs --fakeroot --contain \
    $BINDS $ENV_PASS \
    "$SIF" /bin/sh /setup.sh "$@"
