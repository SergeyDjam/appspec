# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
#
# Template: "appimage" — извлекает AppImage и собирает системные библиотеки.
# Второй проход ldd + Qt5 + /usr/bin и /usr/bin/lib в ld.so.conf.d.
#
# Требует в спеке:
#   build.source.type = "appimage"
#   build.source.url  = URL AppImage
#   build.collect.binary = путь внутри squashfs-root (например "usr/bin/openshot-qt")

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        file \
        binutils \
        libc6 \
        libstdc++6 \
        libgcc-s1 \
        libgl1 \
        libglx-mesa0 \
        libegl1 \
        libx11-6 \
        libxext6 \
        libxrender1 \
        libxtst6 \
        libxi6 \
        libxrandr2 \
        libxcursor1 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libgtk-3-0 \
        libgdk-pixbuf-2.0-0 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        libnss3 \
        libnspr4 \
        libdbus-1-3 \
        libfontconfig1 \
        fonts-dejavu-core \
{%- for p in build.apt.extra %}
        {{ p }} \
{%- endfor %}
    && rm -rf /var/lib/apt/lists/*

ARG SRC_URL={{ source_url }}
RUN set -e ; \
    wget -q -O /tmp/app.AppImage "$SRC_URL" ; \
    chmod +x /tmp/app.AppImage ; \
    cd /tmp ; \
    ./app.AppImage --appimage-extract ; \
    mkdir -p /bundle ; \
    cp -a /tmp/squashfs-root/. /bundle/ ; \
    rm -f /tmp/app.AppImage ; \
    echo "=== extracted AppImage ===" ; \
    ls -la /bundle/ | head -30

# Починить абсолютные симлинки AppImage
RUN set -eu ; \
    find /bundle -type l | while IFS= read -r link ; do \
        target=$(readlink "$link") ; \
        case "$target" in \
            /bundle/*) continue ;; \
            /*) \
                if [ -e "/bundle$target" ] ; then \
                    ln -sfn "/bundle$target" "$link" ; \
                fi ;; \
        esac ; \
    done

# ========== Stage 2: collector ==========
FROM builder AS collector

RUN apt-get update && apt-get install -y --no-install-recommends \
        coreutils findutils \
    && rm -rf /var/lib/apt/lists/*

RUN cat > /usr/local/bin/bundle-copy.sh <<'BCEOF'
#!/bin/sh
set -eu
bundle_copy() {
    f="$1"
    if [ ! -e "$f" ] && [ ! -L "$f" ]; then
        return 0
    fi
    cp -aL --parents "$f" /bundle 2>/dev/null || true
}
for arg in "$@"; do
    bundle_copy "$arg"
done
BCEOF
RUN chmod +x /usr/local/bin/bundle-copy.sh

# --- Основной бинарник внутри AppImage ---
RUN set -eu ; \
    BIN="{{ binary | sh_quote }}" ; \
    case "$BIN" in \
        /*) TARGET="/bundle$BIN" ;; \
        *)  TARGET="/bundle/$BIN" ;; \
    esac ; \
    if [ ! -e "$TARGET" ] && [ ! -L "$TARGET" ]; then \
        echo "ERROR: binary not found in AppImage: $TARGET" >&2 ; \
        find /bundle -maxdepth 4 -type f -executable | head -30 >&2 ; \
        exit 1 ; \
    fi ; \
    echo "=== target: $TARGET ===" ; \
    /usr/local/bin/bundle-copy.sh "$TARGET" ; \
    export LD_LIBRARY_PATH="/bundle/usr/bin:/bundle/usr/bin/lib:/bundle/usr/lib:/bundle/usr/lib/x86_64-linux-gnu:/bundle/lib:/bundle/lib/x86_64-linux-gnu" ; \
    ldd "$TARGET" 2>/dev/null \
        | awk '/=> \// {print $3} /^\// {print $1}' \
        | while IFS= read -r lib ; do \
            [ -f "$lib" ] || continue ; \
            /usr/local/bin/bundle-copy.sh "$lib" ; \
        done ; \
    echo "=== /bundle after main ldd ===" ; \
    du -sh /bundle

# --- Второй проход: ldd по всем .so в /bundle ---
RUN set -eu ; \
    export LD_LIBRARY_PATH="/bundle/usr/bin:/bundle/usr/bin/lib:/bundle/usr/lib:/bundle/usr/lib/x86_64-linux-gnu:/bundle/lib:/bundle/lib/x86_64-linux-gnu" ; \
    : > /tmp/all-deps.txt ; \
    find /bundle \( -name '*.so' -o -name '*.so.*' \) -type f | while IFS= read -r so ; do \
        ldd "$so" 2>/dev/null \
            | awk '/=> \// {print $3} /^\// {print $1}' \
            >> /tmp/all-deps.txt || true ; \
    done ; \
    sort -u /tmp/all-deps.txt | while IFS= read -r lib ; do \
        [ -f "$lib" ] || continue ; \
        /usr/local/bin/bundle-copy.sh "$lib" ; \
    done ; \
    echo "=== /bundle after second-pass ldd ===" ; \
    du -sh /bundle

# --- Qt5 из builder в /bundle ---
RUN set -eu ; \
    mkdir -p /bundle/usr/lib/x86_64-linux-gnu ; \
    for f in /usr/lib/x86_64-linux-gnu/libQt5*.so* \
             /usr/lib/x86_64-linux-gnu/libicu*.so* ; do \
        [ -e "$f" ] || continue ; \
        real=$(readlink -f "$f") ; \
        base=$(basename "$f") ; \
        cp -L "$real" "/bundle/usr/lib/x86_64-linux-gnu/$base" ; \
        ldd "$real" 2>/dev/null \
            | awk '/=> \// {print $3} /^\// {print $1}' \
            | while IFS= read -r lib ; do \
                [ -f "$lib" ] || continue ; \
                /usr/local/bin/bundle-copy.sh "$lib" ; \
            done ; \
    done ; \
    echo "=== Qt5 libs in /bundle ===" ; \
    ls -la /bundle/usr/lib/x86_64-linux-gnu/libQt5*.so* 2>/dev/null | head -20

# --- Qt-плагины (xcb, imageformats, styles) ---
RUN set -eu ; \
    for d in /usr/lib/x86_64-linux-gnu/qt5/plugins /usr/lib/x86_64-linux-gnu/qt5/libexec ; do \
        [ -d "$d" ] || continue ; \
        mkdir -p "/bundle$d" ; \
        cp -a "$d/." "/bundle$d/" ; \
        echo "  + qt5 dir: $d" ; \
    done

# --- ELF-интерпретатор ---
RUN set -eu ; \
    for p in /lib64/ld-linux-x86-64.so.2 /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 ; do \
        [ -e "$p" ] || continue ; \
        real=$(readlink -f "$p") ; \
        mkdir -p "/bundle$(dirname "$p")" ; \
        cp -L "$real" "/bundle$p" ; \
        chmod 755 "/bundle$p" ; \
        echo "  + ld-linux: $p" ; \
    done

# --- libpython в /usr/bin/lib → симлинк в /usr/lib ---
RUN set -eu ; \
    for f in /bundle/usr/bin/lib/libpython3*.so* ; do \
        [ -e "$f" ] || continue ; \
        base=$(basename "$f") ; \
        mkdir -p /bundle/usr/lib ; \
        ln -sf "/usr/bin/lib/$base" "/bundle/usr/lib/$base" ; \
        echo "  + libpython symlink: /usr/lib/$base -> /usr/bin/lib/$base" ; \
    done

# --- openshot-qt-launch fallback ---
RUN set -eu ; \
    if [ -e /bundle/usr/bin/openshot-qt ] && [ ! -e /bundle/usr/bin/openshot-qt-launch ] ; then \
        echo "WARN: openshot-qt-launch missing, creating symlink to openshot-qt" ; \
        ln -sf openshot-qt /bundle/usr/bin/openshot-qt-launch ; \
    fi ; \
    ls -la /bundle/usr/bin/openshot-qt* 2>/dev/null || true

# --- Системные файлы. Без heredoc, всё через printf. ---
RUN set -eu ; \
    mkdir -p /bundle/etc /bundle/etc/ld.so.conf.d ; \
    if [ -f /etc/ld.so.cache ]; then \
        cp -a /etc/ld.so.cache /bundle/etc/ld.so.cache ; \
    fi ; \
    if [ -f /etc/ld.so.conf ]; then \
        cp -a /etc/ld.so.conf /bundle/etc/ld.so.conf ; \
    fi ; \
    if [ -d /etc/ld.so.conf.d ]; then \
        cp -a /etc/ld.so.conf.d/. /bundle/etc/ld.so.conf.d/ 2>/dev/null || true ; \
    fi ; \
    printf '%s\n' \
        '/usr/bin' \
        '/usr/bin/lib' \
        '/usr/lib' \
        '/usr/lib/x86_64-linux-gnu' \
        '/lib/x86_64-linux-gnu' \
        > /bundle/etc/ld.so.conf.d/appimage.conf ; \
    printf 'passwd: files\ngroup: files\nhosts: files dns\n' > /bundle/etc/nsswitch.conf ; \
    printf 'root:x:0:0:root:/root:/bin/sh\n' > /bundle/etc/passwd ; \
    printf 'root:x:0:\n' > /bundle/etc/group ; \
    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then \
        mkdir -p /bundle/etc/ssl/certs ; \
        cp -a /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/ ; \
        ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/cert.pem ; \
    fi

# --- Пересобрать ld.so.cache для /bundle ---
RUN if command -v ldconfig >/dev/null 2>&1 \
       && [ -f /bundle/etc/ld.so.conf ] ; then \
        ldconfig -r /bundle 2>/dev/null || true ; \
        echo "=== ldconfig check ===" ; \
        ldconfig -r /bundle -p 2>/dev/null | grep -E 'libopenshot|libpython|libQt5Core' || true ; \
    fi

# --- busybox ---
RUN set -eu ; \
    mkdir -p /bundle/bin ; \
    wget -q "{{ busybox_url }}" -O /bundle/bin/busybox ; \
    chmod +x /bundle/bin/busybox ; \
    cd /bundle/bin ; \
    for applet in \
         sh ash cat cp mv rm mkdir rmdir ls ln chmod chown \
         id whoami sed awk grep egrep fgrep tr cut head tail \
         sort uniq tee echo printf sleep true false test env \
         printenv date hostname uname basename dirname readlink \
         realpath find xargs tar gzip gunzip touch stat du df ps kill; do \
         [ -e "./$applet" ] || ln -s busybox "./$applet" ; \
    done ; \
    ls -la /bundle/bin/ | head -20

# --- Apptainer startscript ---
RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# ========== Stage 3: final scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}