# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
#
# Template: "scratch" — минимально возможный SIF для статических бинарников.
#
# Внутри:
#   * целевой бинарник (по [build.collect].binary)
#   * /etc/ssl/certs/ca-certificates.crt (для HTTPS)
#   * опциональные includes из [build.collect].includes
#
# Чего НЕТ и почему:
#   * busybox           — не нужен. apptainer exec использует прямой execve.
#   * startscript       — не нужен, только apptainer exec.
#   * /bin/sh           — не нужен, setup-скрипт не выполняется.
#
# ТРЕБУЕТ: [runtime].mode = "cli".
# Не работает: `apptainer shell`, `apptainer instance start`, `[runtime].setup`.
# Ожидаемый размер SIF: размер бинарника + ~250 КБ.
#
# Требует: source.type = "binary" | "tar".

# ========== Stage 1: builder — только скачивание ==========
FROM {{ build.base }} AS builder

{% if "alpine" in build.base %}
RUN apk add --no-cache ca-certificates wget
{% else %}
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
{% endif %}

ARG SRC_URL={{ source_url }}

{% if build.source.type == "binary" %}
RUN set -e ; \
    DEST="{{ build.source.dest | default("/usr/local/bin/tool") }}" ; \
    mkdir -p "$(dirname "$DEST")" ; \
    wget -q -O "$DEST" "$SRC_URL" ; \
    chmod +x "$DEST" ; \
    echo "=== binary info ===" ; \
    ls -la "$DEST" ; \
    file -b "$DEST" || true

{% elif build.source.type == "tar" or build.source.type == "tgz" or build.source.type == "targz" %}
RUN set -e ; \
    wget -q -O /tmp/pkg.tar.gz "$SRC_URL" ; \
    mkdir -p "{{ build.source.extract_to | default("/usr/local") }}" ; \
    tar -xzf /tmp/pkg.tar.gz \
        -C "{{ build.source.extract_to | default("/usr/local") }}" \
{%- if build.source.strip_components %}
        --strip-components={{ build.source.strip_components }} \
{%- endif %}
    ; \
    rm -f /tmp/pkg.tar.gz ; \
    echo "=== extracted ===" ; \
    ls -la "{{ build.source.extract_to | default("/usr/local") }}"

{% else %}
RUN echo "ERROR: template 'scratch' requires source.type = binary|tar" >&2 ; exit 1
{% endif %}

# ========== Stage 2: collector — минимальный rootfs ==========
FROM builder AS collector

# --- CA-сертификаты ---
RUN mkdir -p /bundle/etc/ssl/certs \
    && cp /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/ \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/cert.pem \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/cert.pem

# --- Целевой бинарник ---
RUN set -e ; \
    TARGET="{{ binary | sh_quote }}" ; \
    mkdir -p "/bundle$(dirname "$TARGET")" ; \
    cp "$TARGET" "/bundle$TARGET" ; \
    chmod +x "/bundle$TARGET" ; \
    echo "=== target: /bundle$TARGET ===" ; \
    ls -la "/bundle$TARGET"

# --- Опциональные includes ---
RUN set -e ; \
{%- if build.collect.includes %}
    for f in \
{%- for inc in build.collect.includes %}
        "{{ inc }}" \
{%- endfor %}
    ; do \
        if [ -f "$f" ]; then \
            mkdir -p "/bundle$(dirname "$f")" ; \
            cp -a "$f" "/bundle$f" ; \
            echo "  + $f" ; \
        elif [ -d "$f" ]; then \
            mkdir -p "/bundle$f" ; \
            cp -a "$f/." "/bundle$f/" ; \
            echo "  + $f/ (recursive)" ; \
        fi ; \
    done ; \
{%- endif %}
    echo "=== /bundle final ===" ; \
    du -sh /bundle ; \
    find /bundle -mindepth 1 -maxdepth 3 | sort

# ========== Stage 3: final scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}