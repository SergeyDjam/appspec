# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
#
# Template: "full" — собираем SIF без magicpak.
# Весь rootfs из builder копируется в scratch целиком. Это даёт больший
# размер SIF (~500 МБ вместо ~250 МБ), но работает для приложений,
# которые magicpak не умеет обрабатывать (Electron/Chromium с sandbox,
# GUI-фреймворки с активным ptrace, и т.п.).
#
# Требует: base = debian/ubuntu (использует apt + dpkg-deb).

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
{%- for t in build.tools %}
        {{ t }} \
{%- endfor %}
    && rm -rf /var/lib/apt/lists/*

{% if build.source.url %}
ARG SRC_URL={{ source_url }}

# --- apt-get satisfy понимает грамматику Depends, включая альтернативы
# --- 'A | B | C' — выбирает первую доступную в репозитории. apt-get install
# --- так не умеет: он видит '|' как отдельный аргумент и падает на
# --- последней альтернативе, которой может не быть.
# --- КАВЫЧКИ вокруг "$DEPS" обязательны.
# ---
# --- rm -rf (не -f): в /var/lib/apt/lists/ есть подкаталоги, -f на них падает.
# --- Диагностика печатает верхнеуровневые каталоги из /usr/bin и /usr/share
# --- после распаковки — чтобы видеть, что реально принесла инсталляция.
RUN set -e ; \
    wget -q -O /tmp/pkg.deb "$SRC_URL" ; \
    echo "=== .deb size: $(du -h /tmp/pkg.deb | cut -f1) ===" ; \
    DEPS=$(dpkg-deb -f /tmp/pkg.deb Depends | sed 's/ ([^)]*)//g') ; \
    echo "=== DEPS: $DEPS ===" ; \
    apt-get update ; \
    apt-get satisfy -y --no-install-recommends "$DEPS" ; \
{%- if build.apt.extra %}
    apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
           {{ p }} \
{%- endfor %}
        ; \
{%- endif %}
    dpkg-deb -x /tmp/pkg.deb / ; \
    echo "=== /usr/bin (first 20) ===" ; \
    ls /usr/bin/ | head -20 ; \
    echo "=== /usr/share (first 20) ===" ; \
    ls /usr/share/ | head -20 ; \
    rm -rf /tmp/pkg.deb /var/lib/apt/lists/*
{% elif build.apt.extra %}
RUN apt-get update && apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
        {{ p }} \
{%- endfor %}
    && rm -rf /var/lib/apt/lists/*
{% endif %}

# --- startscript: Apptainer требует его для `instance start`. ---
RUN mkdir -p /.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /.singularity.d/startscript \
    && chmod 0755 /.singularity.d/startscript \
    && cp /.singularity.d/startscript /.singularity.d/runscript

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}

# ========== Stage 2: final — весь rootfs как есть ==========
FROM scratch
COPY --from=builder / /