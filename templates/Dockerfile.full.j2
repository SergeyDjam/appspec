# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
#
# Template: "full" — собираем SIF без magicpak.
# Весь rootfs из builder копируется в scratch целиком.
# Поддерживает source.type = deb | tar | tgz | targz | "" (только apt).
# Требует: base = debian/ubuntu (apt + dpkg-deb).

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
{%- for t in build.tools %}
        {{ t }} \
{%- endfor %}
    && rm -rf /var/lib/apt/lists/*

{% if build.source.type == "tar" or build.source.type == "tgz" or build.source.type == "targz" %}
# --- tar/tgz: скачать и распаковать в extract_to ---
ARG SRC_URL={{ source_url }}

RUN set -e ; \
    wget -q -O /tmp/pkg.tar.gz "$SRC_URL" ; \
    mkdir -p "{{ build.source.extract_to | default("/opt") }}" ; \
    tar -xzf /tmp/pkg.tar.gz \
        -C "{{ build.source.extract_to | default("/opt") }}" \
{%- if build.source.strip_components %}
        --strip-components={{ build.source.strip_components }} \
{%- endif %}
    ; \
    rm -f /tmp/pkg.tar.gz ; \
    echo "=== extracted ===" ; \
    ls -la "{{ build.source.extract_to | default("/opt") }}"

{% if build.apt.extra -%}
RUN apt-get update && apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
        {{ p }} \
{%- endfor %}
    && rm -rf /var/lib/apt/lists/*
{% endif -%}

{% elif build.source.url %}
# --- deb: apt-get satisfy + dpkg-deb ---
ARG SRC_URL={{ source_url }}

RUN set -e ; \
    wget -q -O /tmp/pkg.deb "$SRC_URL" ; \
    echo "=== .deb size: $(du -h /tmp/pkg.deb | cut -f1) ===" ; \
    DEPS=$(dpkg-deb -f /tmp/pkg.deb Depends | sed 's/ ([^)]*)//g') ; \
    echo "=== DEPS: $DEPS ===" ; \
    apt-get update ; \
    apt-get satisfy -y --no-install-recommends "$DEPS" ; \
{%- if build.apt.extra %}
    apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
           {{ p }} \
{%- endfor %}
        ; \
{%- endif %}
    dpkg-deb -x /tmp/pkg.deb / ; \
    rm -rf /tmp/pkg.deb /var/lib/apt/lists/*

{% elif build.apt.extra %}
# --- только apt-пакеты, без источника ---
RUN apt-get update && apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
        {{ p }} \
{%- endfor %}
    && rm -rf /var/lib/apt/lists/*
{% endif %}

# --- startscript: Apptainer требует его для `instance start`. ---
RUN mkdir -p /.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /.singularity.d/startscript \
    && chmod 0755 /.singularity.d/startscript \
    && cp /.singularity.d/startscript /.singularity.d/runscript

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}

# ========== Stage 2: final — весь rootfs как есть ==========
FROM scratch
COPY --from=builder / /