#!/bin/sh
# Auto-generated by appspec — CLI mode for {{ pkg.name }} {{ pkg.version }}
set -eu

SPEC_DIR="$(cd "$(dirname "$0")" && pwd)"
SIF_FILE="$SPEC_DIR/{{ sif_file }}"

if [ ! -f "$SIF_FILE" ]; then
    echo "SIF not found: $SIF_FILE" >&2
    echo "Build with: appspec build <spec.toml>" >&2
    exit 1
fi

HOST_PWD="$(pwd -P)"
HOST_HOME="${HOME:-/tmp}"

# --- bind host cwd и HOME один-в-один ---
BINDS="--bind $HOST_PWD:$HOST_PWD --bind $HOST_HOME:$HOST_HOME"

{% for line in bind_lines -%}
{{ line }}
{% endfor -%}

# --- окружение.
# --- HOME передаётся через --home (Apptainer запрещает --env HOME).
# --- Остальное (TERM, SSH_AUTH_SOCK, GIT_*) — через --env.
X_ENV=""
{% for line in env_checks -%}
{{ line }}
{% endfor -%}

# --- каталоги, которые должны существовать до старта ---
{% for d in create_dirs -%}
[ -e {{ d }} ] || mkdir -p {{ d }} 2>/dev/null || true
{% endfor %}

# --- one-shot exec: без instance, без cleanup ---
# --- --no-passwd: не обновлять /etc/passwd и /etc/group в контейнере;
# ---   в minimal rootfs их может не быть, Apptainer сыпет warning'ами.
exec apptainer exec \
    --containall \
    --home "$HOST_HOME" \
    --pwd "$HOST_PWD" \
    $BINDS $X_ENV \
    "$SIF_FILE" \
    {{ runtime.command | default("/bin/sh") }} "$@"