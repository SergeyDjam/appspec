# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
#
# Template: "qt-static" — компактный сборщик для Qt5/Qt6 GUI-приложений.
#
# Отличия от deb-ldd:
#   * Явно копируются QML-модули (/usr/lib/…/qt6/qml), translations,
#     libexec (QtWebEngineProcess, qml runtime и т. п.).
#   * Генерируется /etc/xdg/QtProject/qt.conf.
# Всё остальное (ldd-сбор, интерпретатор-патч, верификация) — как в deb-ldd.
#
# Почему не magicpak: --dynamic трассирует через ptrace и получает SIGSEGV
# на инициализации Qt/GStreamer. --experimental-noload-resolver не помогает.
#
# Требует: base = debian/ubuntu (apt + dpkg-deb). В trixie нет `file` —
# ELF-проверка через head -c 4 | od -An -c (coreutils есть всегда).

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
{%- for t in build.tools %}
        {{ t }} \
{%- endfor %}
    && apt-get install -y --fix-broken \
    && rm -rf /var/lib/apt/lists/*

ARG SRC_URL={{ source_url }}

# --- .deb + Depends + apt.extra ---
RUN set -eu ; \
    wget -q -O /tmp/pkg.deb "$SRC_URL" ; \
    echo "=== .deb metadata (dpkg-deb --info) ===" ; \
    dpkg-deb --info /tmp/pkg.deb | head -15 ; \
    echo "=== .deb size ===" ; \
    du -h /tmp/pkg.deb ; \
    DEPS=$(dpkg-deb -f /tmp/pkg.deb Depends | sed 's/ ([^)]*)//g') ; \
    echo "--- DEPS: $DEPS" ; \
    apt-get update ; \
    if [ -n "$DEPS" ]; then apt-get satisfy -y --no-install-recommends "$DEPS" ; fi ; \
{%- if build.apt.extra %}
    apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
           {{ p }} \
{%- endfor %}
    ; \
{%- endif %}
    dpkg-deb -x /tmp/pkg.deb / ; \
    ldconfig 2>/dev/null || true ; \
    rm -f /tmp/pkg.deb ; \
    echo "=== after dpkg-deb -x ===" ; \
    ls -la /usr/bin/strawberry 2>&1 || echo "(NOT FOUND!)" ; \
    if [ -e /usr/bin/strawberry ] ; then \
        echo -n "  magic: " ; head -c 4 /usr/bin/strawberry | od -An -c | head -1 ; \
    fi

{% if binary -%}
RUN chmod +x {{ binary | sh_quote }} 2>/dev/null || true

{% endif -%}
# --- gschemas / pixbuf loaders / gio modules / mime: best-effort ---
RUN set -eu ; \
    if command -v glib-compile-schemas >/dev/null 2>&1 \
       && [ -d /usr/share/glib-2.0/schemas ] ; then \
        glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true ; \
    fi ; \
    if command -v gdk-pixbuf-query-loaders >/dev/null 2>&1 \
       && [ -d /usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders ] ; then \
        gdk-pixbuf-query-loaders \
            > /usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache \
            2>/dev/null || true ; \
    fi ; \
    if command -v gio-querymodules >/dev/null 2>&1 \
       && [ -d /usr/lib/x86_64-linux-gnu/gio/modules ] ; then \
        gio-querymodules /usr/lib/x86_64-linux-gnu/gio/modules 2>/dev/null || true ; \
    fi ; \
    if command -v update-mime-database >/dev/null 2>&1 \
       && [ -d /usr/share/mime ] ; then \
        update-mime-database /usr/share/mime 2>/dev/null || true ; \
    fi ; \
    if command -v fc-cache >/dev/null 2>&1 ; then \
        fc-cache -f 2>/dev/null || true ; \
    fi

# ========== Stage 2: collector — ldd вместо magicpak ==========
FROM builder AS collector

RUN apt-get update && apt-get install -y --no-install-recommends \
        coreutils findutils \
    && rm -rf /var/lib/apt/lists/*

# --- helper: копирует файл в /bundle с сохранением абсолютного пути ---
RUN cat > /usr/local/bin/bundle-copy.sh <<'BCEOF'
#!/bin/sh
set -eu
bundle_copy() {
    f="$1"
    if [ ! -e "$f" ] && [ ! -L "$f" ]; then
        return 0
    fi
    cp -a --parents "$f" /bundle 2>/dev/null || true
    if [ -L "$f" ]; then
        real="$(readlink -f "$f" 2>/dev/null || true)"
        if [ -n "${real:-}" ] && [ -f "$real" ]; then
            cp -a --parents "$real" /bundle 2>/dev/null || true
        fi
    fi
}
for arg in "$@"; do
    bundle_copy "$arg"
done
BCEOF
RUN chmod +x /usr/local/bin/bundle-copy.sh

# --- ELF-таргеты: бинарник + Qt5/6 plugins + libexec + GStreamer/GIO/GTK ---
RUN set -eu ; \
    : > /tmp/targets.txt ; \
    TARGET="{{ binary | sh_quote }}" ; \
    echo "$TARGET" >> /tmp/targets.txt ; \
    for d in \
        /usr/lib/x86_64-linux-gnu/qt6/plugins \
        /usr/lib/x86_64-linux-gnu/qt6/libexec \
        /usr/lib/x86_64-linux-gnu/qt5/plugins \
        /usr/lib/x86_64-linux-gnu/qt5/libexec \
        /usr/lib/x86_64-linux-gnu/gstreamer-1.0 \
        /usr/lib/x86_64-linux-gnu/gstreamer-0.10 \
        /usr/libexec/gstreamer-1.0 \
        /usr/lib/x86_64-linux-gnu/gio/modules \
        /usr/lib/x86_64-linux-gnu/gtk-3.0 \
        /usr/lib/x86_64-linux-gnu/gtk-4.0 \
        /usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0 \
        /usr/lib/x86_64-linux-gnu/pango \
        /usr/lib/x86_64-linux-gnu/enchant-2 \
        /usr/lib/x86_64-linux-gnu/libproxy \
        /usr/lib/x86_64-linux-gnu/spa-0.2 \
    ; do \
        [ -d "$d" ] || continue ; \
        find "$d" -type f \( -name '*.so' -o -name '*.so.*' \) \
            >> /tmp/targets.txt ; \
    done ; \
    sort -u /tmp/targets.txt -o /tmp/targets.txt ; \
    echo "=== targets: $(wc -l < /tmp/targets.txt) ===" ; \
    head -20 /tmp/targets.txt

# --- ldd по каждому таргету ---
RUN set -eu ; \
    mkdir -p /bundle ; \
    while IFS= read -r t ; do \
        [ -f "$t" ] || continue ; \
        /usr/local/bin/bundle-copy.sh "$t" ; \
        ldd "$t" 2>/dev/null \
            | awk '/=> \// {print $3} /^\// {print $1}' \
            | while IFS= read -r lib ; do \
                [ -f "$lib" ] || continue ; \
                /usr/local/bin/bundle-copy.sh "$lib" ; \
            done ; \
    done < /tmp/targets.txt ; \
    echo "=== /bundle after ldd ===" ; \
    du -sh /bundle

# --- Патч ELF interpreter (dereference, cp -L) ---
# См. подробное объяснение в Dockerfile.deb-ldd.j2. usrmerge + cp -a --parents
# ломает цепочку симлинков → execve() → ENOENT на FROM scratch.
RUN set -eu ; \
    BIN="{{ binary | sh_quote }}" ; \
    if [ ! -e "/bundle$BIN" ] || ! head -c 4 "/bundle$BIN" 2>/dev/null | grep -q ELF ; \
        then echo "  not ELF (wrapper or missing), skip interpreter patch" ; exit 0 ; \
    fi ; \
    INTERP=$(grep -aoE '/lib(64)?/[a-zA-Z0-9._-]+/(ld-[a-zA-Z0-9._-]+|ld\.so\.[0-9]+|ld-musl-[a-zA-Z0-9._-]+)' "/bundle$BIN" 2>/dev/null | head -1 || true) ; \
    if [ -z "${INTERP:-}" ] ; then \
        INTERP=$(grep -aoE '/lib(64)?/(ld-[a-zA-Z0-9._-]+|ld\.so\.[0-9]+|ld-musl-[a-zA-Z0-9._-]+)' "/bundle$BIN" 2>/dev/null | head -1 || true) ; \
    fi ; \
    echo "  PT_INTERP from binary: ${INTERP:-<undetermined>}" ; \
    for p in \
        "${INTERP:-/nonexistent}" \
        /lib64/ld-linux-x86-64.so.2 \
        /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 \
        /lib64/ld-linux-aarch64.so.1 \
        /lib/ld-linux-aarch64.so.1 \
        /lib/ld-linux.so.2 \
        /lib64/ld-linux.so.2 \
        /lib/ld-musl-x86_64.so.1 \
        /lib/ld-musl-aarch64.so.1 \
    ; do \
        [ -e "$p" ] || continue ; \
        real=$(readlink -f "$p" 2>/dev/null || true) ; \
        [ -e "$real" ] || continue ; \
        mkdir -p "/bundle$(dirname "$p")" ; \
        rm -f "/bundle$p" ; \
        cp -L "$real" "/bundle$p" ; \
        chmod 755 "/bundle$p" ; \
        echo "  + interpreter: $p -> $real" ; \
    done ; \
    for leaf in /lib/x86_64-linux-gnu/ld-2.*.so /usr/lib/x86_64-linux-gnu/ld-2.*.so /lib/ld-2.*.so ; do \
        [ -e "$leaf" ] || continue ; \
        real=$(readlink -f "$leaf" 2>/dev/null || true) ; \
        [ -e "$real" ] || continue ; \
        mkdir -p "/bundle$(dirname "$leaf")" ; \
        cp -L "$real" "/bundle$leaf" 2>/dev/null || true ; \
    done ; \
    echo "=== interpreters in /bundle ===" ; \
    ls -la /bundle/lib64/ld-* 2>/dev/null || true ; \
    ls -la /bundle/lib/x86_64-linux-gnu/ld-* 2>/dev/null || true ; \
    if [ -e /bundle/lib64/ld-linux-x86-64.so.2 ] ; then \
        echo -n "  interp magic: " ; \
        head -c 4 /bundle/lib64/ld-linux-x86-64.so.2 | od -An -c | head -1 ; \
    fi

# --- Верификация бинарника: fallback-поиск + проверка ELF ---
RUN set -eu ; \
    BIN="{{ binary | sh_quote }}" ; \
    if [ ! -e "/bundle$BIN" ] && [ ! -L "/bundle$BIN" ] ; then \
        echo "WARN: $BIN отсутствует в /bundle — ищу альтернативу" ; \
        BN="$(basename "$BIN")" ; \
        ALT="$(find /usr/bin /usr/sbin /usr/lib /usr/libexec /opt /usr/share \
                    -maxdepth 6 -type f -name "$BN" 2>/dev/null | head -1)" ; \
        if [ -z "$ALT" ] ; then \
            echo "ERROR: '$BN' не найден в builder." >&2 ; \
            echo "--- /usr/bin (straw*) ---" >&2 ; \
            ls /usr/bin/ 2>&1 | grep -i straw || echo "(nothing)" >&2 ; \
            echo "--- find /usr /opt ---" >&2 ; \
            find /usr /opt -iname "*strawberry*" 2>/dev/null | head -30 >&2 || true ; \
            exit 1 ; \
        fi ; \
        echo "  found: $ALT" ; \
        /usr/local/bin/bundle-copy.sh "$ALT" ; \
        ldd "$ALT" 2>/dev/null \
            | awk '/=> \// {print $3} /^\// {print $1}' \
            | while IFS= read -r lib ; do \
                [ -f "$lib" ] || continue ; \
                /usr/local/bin/bundle-copy.sh "$lib" ; \
            done ; \
    fi ; \
    if [ -e "/bundle$BIN" ] && ! head -c 4 "/bundle$BIN" 2>/dev/null | grep -q ELF ; then \
        echo "WARN: $BIN не ELF — вероятно shell wrapper, ищу реальный бинарник" ; \
        for cand in \
            /usr/lib/strawberry/strawberry \
            /usr/lib/x86_64-linux-gnu/strawberry/strawberry \
            /usr/libexec/strawberry \
            /opt/strawberry/bin/strawberry \
        ; do \
            if [ -f "$cand" ] ; then \
                echo "  found real: $cand" ; \
                /usr/local/bin/bundle-copy.sh "$cand" ; \
                ldd "$cand" 2>/dev/null \
                    | awk '/=> \// {print $3} /^\// {print $1}' \
                    | while IFS= read -r lib ; do \
                        [ -f "$lib" ] || continue ; \
                        /usr/local/bin/bundle-copy.sh "$lib" ; \
                    done ; \
            fi ; \
        done ; \
    fi ; \
    echo "=== final binary check ===" ; \
    ls -la "/bundle$BIN" 2>&1 || true ; \
    if [ -e "/bundle$BIN" ] ; then \
        echo -n "  magic: " ; head -c 4 "/bundle$BIN" | od -An -c | head -1 ; \
        if head -c 4 "/bundle$BIN" | grep -q ELF ; then \
            echo "  type: ELF (ok)" ; \
        else \
            echo "  type: not ELF (wrapper/script)" ; \
            head -3 "/bundle$BIN" 2>/dev/null | sed 's/^/  | /' ; \
        fi ; \
    fi

# --- Qt-специфика: QML, translations, libexec, plugins metadata ---
RUN set -eu ; \
    for d in \
        /usr/lib/x86_64-linux-gnu/qt6/qml \
        /usr/lib/x86_64-linux-gnu/qt5/qml \
        /usr/share/qt6/translations \
        /usr/share/qt5/translations \
        /usr/share/qt6/resources \
        /usr/share/qt5/resources \
        /usr/lib/x86_64-linux-gnu/qt6/plugins \
        /usr/lib/x86_64-linux-gnu/qt5/plugins \
        /usr/lib/x86_64-linux-gnu/qt6/libexec \
        /usr/lib/x86_64-linux-gnu/qt5/libexec \
    ; do \
        [ -d "$d" ] || continue ; \
        echo "  + $d (recursive)" ; \
        find "$d" \( -type f -o -type l \) \
            | while IFS= read -r f ; do \
                /usr/local/bin/bundle-copy.sh "$f" ; \
            done ; \
    done ; \
    echo "=== /bundle after qt resources ===" ; \
    du -sh /bundle

# --- Системные файлы ---
RUN set -eu ; \
    mkdir -p /bundle/etc ; \
    if [ -f /etc/ld.so.cache ]; then \
        cp -a /etc/ld.so.cache /bundle/etc/ld.so.cache ; \
    fi ; \
    if [ -f /etc/ld.so.conf ]; then \
        cp -a /etc/ld.so.conf /bundle/etc/ld.so.conf ; \
    fi ; \
    if [ -d /etc/ld.so.conf.d ]; then \
        mkdir -p /bundle/etc/ld.so.conf.d ; \
        cp -a /etc/ld.so.conf.d/. /bundle/etc/ld.so.conf.d/ 2>/dev/null || true ; \
    fi ; \
    printf 'passwd: files\ngroup: files\nhosts: files dns\n' \
        > /bundle/etc/nsswitch.conf ; \
    printf 'root:x:0:0:root:/root:/bin/sh\n' > /bundle/etc/passwd ; \
    printf 'root:x:0:\n' > /bundle/etc/group ; \
    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then \
        mkdir -p /bundle/etc/ssl/certs ; \
        cp -a /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/ ; \
        ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/cert.pem ; \
        ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/cert.pem ; \
    fi ; \
    if [ -e /bin/bash ] && [ ! -e /bundle/bin/bash ] ; then \
        mkdir -p /bundle/bin ; \
        cp -L "$(readlink -f /bin/bash)" /bundle/bin/bash ; \
        chmod 755 /bundle/bin/bash ; \
        echo "  + /bundle/bin/bash" ; \
    fi ; \
    if [ -e /bin/dash ] && [ ! -e /bundle/bin/dash ] ; then \
        mkdir -p /bundle/bin ; \
        cp -L "$(readlink -f /bin/dash)" /bundle/bin/dash ; \
        chmod 755 /bundle/bin/dash ; \
        echo "  + /bundle/bin/dash" ; \
    fi

# --- gschemas / pixbuf / gio / mime / hicolor ---
RUN set -eu ; \
    for g in \
        /usr/share/glib-2.0/schemas \
        /usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0 \
        /usr/lib/x86_64-linux-gnu/gio/modules \
        /usr/share/mime \
        /usr/share/icons/hicolor \
    ; do \
        [ -d "$g" ] || continue ; \
        find "$g" \( -type f -o -type l \) \
            | while IFS= read -r f ; do \
                /usr/local/bin/bundle-copy.sh "$f" ; \
            done ; \
    done ; \
    du -sh /bundle

# --- Пересобрать ld.so.cache для /bundle ---
RUN if command -v ldconfig >/dev/null 2>&1 \
       && [ -f /bundle/etc/ld.so.conf ] ; then \
        ldconfig -r /bundle 2>/dev/null || true ; \
    fi

# --- qt.conf: Qt ищет плагины в бандле ---
# Env QT_PLUGIN_PATH (из [build.scratch.env]) имеет приоритет над qt.conf.
RUN set -eu ; \
    mkdir -p /bundle/etc/xdg/QtProject ; \
    { \
      echo '[Paths]' ; \
      echo 'Prefix=/usr' ; \
      echo 'Plugins=/usr/lib/x86_64-linux-gnu/qt6/plugins' ; \
      echo 'Qml2Imports=/usr/lib/x86_64-linux-gnu/qt6/qml' ; \
      echo 'LibraryExecutables=/usr/lib/x86_64-linux-gnu/qt6/libexec' ; \
      echo 'Translations=/usr/share/qt6/translations' ; \
    } > /bundle/etc/xdg/QtProject/qt.conf ; \
    echo '=== qt.conf ===' ; cat /bundle/etc/xdg/QtProject/qt.conf

# --- Опциональные includes из спека ---
RUN set -eu ; \
{%- if build.collect.includes %}
    for g in \
{%- for inc in build.collect.includes %}
        "{{ inc }}" \
{%- endfor %}
    ; do \
        for f in $g ; do \
            if [ -e "$f" ] || [ -L "$f" ]; then \
                /usr/local/bin/bundle-copy.sh "$f" ; \
            elif [ -d "$f" ]; then \
                find "$f" \( -type f -o -type l \) \
                    | while IFS= read -r sub ; do \
                        /usr/local/bin/bundle-copy.sh "$sub" ; \
                    done ; \
            fi ; \
        done ; \
    done ; \
{%- endif %}
    echo "=== /bundle after includes ===" ; \
    du -sh /bundle

# --- busybox + symlinks (bash — не applet busybox, копируется выше) ---
RUN set -eu ; \
    mkdir -p /bundle/bin ; \
    wget -q "{{ busybox_url }}" -O /bundle/bin/busybox ; \
    chmod +x /bundle/bin/busybox ; \
    cd /bundle/bin ; \
    for applet in \
         sh ash cat cp mv rm mkdir rmdir ls ln chmod chown \
         id whoami sed awk grep egrep fgrep tr cut head tail \
         sort uniq tee echo printf sleep true false test env \
         printenv date hostname uname basename dirname readlink \
         realpath find xargs tar gzip gunzip touch stat du df ps kill \
         expr od hexdump; do \
         [ -e "./$applet" ] || ln -s busybox "./$applet" ; \
    done ; \
    ls -la /bundle/bin/ | head -25

# --- Apptainer startscript ---
RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# --- Финальная диагностика ---
RUN echo "=== final bundle size ===" ; du -sh /bundle ; \
    echo "=== target binary ===" ; \
    ls -la "{{ binary | sh_quote }}" 2>/dev/null || true ; \
    if [ -e "{{ binary | sh_quote }}" ] ; then \
        echo -n "  magic: " ; head -c 4 "{{ binary | sh_quote }}" | od -An -c | head -1 ; \
    fi ; \
    echo "=== interpreters ===" ; \
    ls -la /bundle/lib64/ld-* /bundle/lib/x86_64-linux-gnu/ld-* 2>/dev/null || true ; \
    echo "=== qt plugins ===" ; \
    ls /bundle/usr/lib/x86_64-linux-gnu/qt6/plugins/ 2>/dev/null | head -20 || true ; \
    echo "=== gstreamer plugins ===" ; \
    ls /bundle/usr/lib/x86_64-linux-gnu/gstreamer-1.0/ 2>/dev/null | head -10 || true

# ========== Stage 3: final scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}