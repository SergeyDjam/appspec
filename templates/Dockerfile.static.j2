# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
#
# Template: "static" — минимальный SIF для статических бинарников.
#
# Внутри:
#   * целевой бинарник (по [build.collect].binary)
#   * /etc/ssl/certs/ca-certificates.crt (для HTTPS)
#   * busybox + symlinks (sh, cat, ls, grep, …) — для setup/shell
#   * /.singularity.d/startscript — для apptainer instance start
#   * опциональные includes из [build.collect].includes
#
# Работает для: uv (musl), minikube, jq, ripgrep, fd, bat, fzf, just, zoxide.
# Ожидаемый размер SIF: размер бинарника + ~1.5 МБ.
#
# Требует: source.type = "binary" | "tar".

# ========== Stage 1: builder — только скачивание ==========
FROM {{ build.base }} AS builder

{% if "alpine" in build.base %}
RUN apk add --no-cache ca-certificates wget
{% else %}
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
{% endif %}

ARG SRC_URL={{ source_url }}

{% if build.source.type == "binary" %}
RUN set -e ; \
    DEST="{{ build.source.dest | default("/usr/local/bin/tool") }}" ; \
    mkdir -p "$(dirname "$DEST")" ; \
    wget -q -O "$DEST" "$SRC_URL" ; \
    chmod +x "$DEST" ; \
    echo "=== binary info ===" ; \
    ls -la "$DEST" ; \
    file -b "$DEST" || true

{% elif build.source.type == "tar" or build.source.type == "tgz" or build.source.type == "targz" %}
RUN set -e ; \
    wget -q -O /tmp/pkg.tar.gz "$SRC_URL" ; \
    mkdir -p "{{ build.source.extract_to | default("/usr/local") }}" ; \
    tar -xzf /tmp/pkg.tar.gz \
        -C "{{ build.source.extract_to | default("/usr/local") }}" \
{%- if build.source.strip_components %}
        --strip-components={{ build.source.strip_components }} \
{%- endif %}
    ; \
    rm -f /tmp/pkg.tar.gz ; \
    echo "=== extracted ===" ; \
    ls -la "{{ build.source.extract_to | default("/usr/local") }}"

{% else %}
RUN echo "ERROR: template 'static' requires source.type = binary|tar" >&2 ; exit 1
{% endif %}

# ========== Stage 2: collector — минимальный rootfs ==========
FROM builder AS collector

# --- CA-сертификаты: ~200 КБ, нужны для HTTPS ---
RUN mkdir -p /bundle/etc/ssl/certs \
    && cp /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/ \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/cert.pem \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/cert.pem

# --- Целевой бинарник ---
RUN set -e ; \
    TARGET="{{ binary | sh_quote }}" ; \
    mkdir -p "/bundle$(dirname "$TARGET")" ; \
    cp "$TARGET" "/bundle$TARGET" ; \
    chmod +x "/bundle$TARGET" ; \
    echo "=== target: /bundle$TARGET ===" ; \
    ls -la "/bundle$TARGET"

# --- Опциональные includes (файл или каталог рекурсивно) ---
RUN set -e ; \
{%- if build.collect.includes %}
    for f in \
{%- for inc in build.collect.includes %}
        "{{ inc }}" \
{%- endfor %}
    ; do \
        if [ -f "$f" ]; then \
            mkdir -p "/bundle$(dirname "$f")" ; \
            cp -a "$f" "/bundle$f" ; \
            echo "  + $f" ; \
        elif [ -d "$f" ]; then \
            mkdir -p "/bundle$f" ; \
            cp -a "$f/." "/bundle$f/" ; \
            echo "  + $f/ (recursive)" ; \
        fi ; \
    done ; \
{%- endif %}
    echo "=== /bundle after includes ===" ; \
    du -sh /bundle

# --- busybox как мульти-applet ---
RUN set -e ; \
    mkdir -p /bundle/bin ; \
    wget -q "{{ busybox_url }}" -O /bundle/bin/busybox ; \
    chmod +x /bundle/bin/busybox ; \
    cd /bundle/bin ; \
    for applet in \
         sh ash cat cp mv rm mkdir rmdir ls ln chmod chown \
         id whoami sed awk grep egrep fgrep tr cut head tail \
         sort uniq tee echo printf sleep true false test env \
         printenv date hostname uname basename dirname readlink \
         realpath find xargs tar gzip gunzip touch stat du df ps kill; do \
         [ -e "./$applet" ] || ln -s busybox "./$applet" ; \
    done ; \
    ls -la /bundle/bin/ | head -20

# --- Apptainer startscript: instance start + shell для отладки ---
RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# ========== Stage 3: final scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}