# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
# Target: Alpine Linux (musl libc)
#
# Alpine-специфика: magicpak --dynamic не работает на musl-таргетах
# (падает с "IO error: No such file or directory" до старта target'а).
# Используем Alpine-native `apk --root /bundle`:
# apk разрешает зависимости и разворачивает минимальный rootfs.

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder

# Ничего особенного — apk уже в базовом образе.

# ========== Stage 2: collector (apk --root) ==========
FROM builder AS collector

# --- apk --root меняет корень для ВСЕГО: и репозитории, и ключи подписи.
# --- Поэтому:
# ---   * --repositories-file /etc/apk/repositories  — список репо (иначе
# ---     ищется в /bundle/etc/apk/repositories, которого нет);
# ---   * ключи подписи копируем вручную в /bundle/etc/apk/keys/;
# ---   * --arch x86_64 фиксируем (apk иначе пытается определить
# ---     архитектуру через /bundle/bin/busybox);
# ---   * --allow-untrusted — страховка, если ключи по какой-то причине
# ---     не совпадут с подписью репозитория.
RUN set -e ; \
    mkdir -p /bundle/etc/apk/keys ; \
    cp -a /etc/apk/keys/. /bundle/etc/apk/keys/ ; \
    PKGS="{{ build.apt.extra | join(" ") }}" ; \
    for base in musl busybox ca-certificates ; do \
        case " $PKGS " in \
            *" $base "*) ;; \
            *) PKGS="$PKGS $base" ;; \
        esac ; \
    done ; \
    echo "=== apk add --root /bundle: $PKGS ===" ; \
    apk --root /bundle \
        --repositories-file /etc/apk/repositories \
        --arch x86_64 \
        --initdb \
        --no-scripts \
        --no-cache \
        --allow-untrusted \
        add $PKGS ; \
    # чистим apk-tools из бандла — в рантайме не нужны
    rm -rf /bundle/var/cache/apk/* \
           /bundle/lib/apk \
           /bundle/usr/share/apk \
           /bundle/sbin/apk* \
           /bundle/etc/apk ; \
    echo "=== /bundle top level ===" ; \
    ls -la /bundle/

# --- apk --root --no-scripts не выполняет post-install-скрипты,
# --- поэтому /etc/passwd и /etc/group в бандле отсутствуют. Многие
# --- сервисы на старте вызывают getpwnam(3) — nginx, sshd, podman,
# --- angie — и падают с "getpwnam(\"…\") failed (2: No such file or
# --- directory)". Создаём минимальные файлы, этого хватает для
# --- fakeroot-инстансов. Если сервису нужен конкретный пользователь
# --- (например nginx:x:100:101), добавьте его строкой ниже.
RUN mkdir -p /bundle/etc \
    && printf 'root:x:0:0:root:/root:/sbin/nologin\n' \
         > /bundle/etc/passwd \
    && printf 'root:x:0:\nnogroup:x:65534:\n' \
         > /bundle/etc/group \
    && printf 'passwd: files\ngroup: files\nhosts: files dns\n' \
         > /bundle/etc/nsswitch.conf \
    && mkdir -p /bundle/run /bundle/var/run

# --- Опциональные includes из спека — просто копируем файлы поверх. ---
RUN set -e ; \
    for g in \
        /etc/ssl/certs/ca-certificates.crt \
        ; do \
        [ -f "$g" ] || continue ; \
        [ -f "/bundle$g" ] && continue ; \
        mkdir -p "/bundle$(dirname "$g")" ; \
        cp -a "$g" "/bundle$g" ; \
    done ; \
    du -sh /bundle

# --- busybox как мульти-applet: symlinks для /bin/sh и утилит. ---
RUN set -e ; \
    mkdir -p /bundle/bin ; \
    cd /bundle/bin ; \
    if [ ! -x ./busybox ] ; then \
        wget -q "{{ busybox_url }}" -O ./busybox ; \
        chmod +x ./busybox ; \
    fi ; \
    for applet in \
         sh ash cat cp mv rm mkdir rmdir ls ln chmod chown \
         id whoami sed awk grep egrep fgrep tr cut head tail \
         sort uniq tee echo printf sleep true false test env \
         printenv date hostname uname basename dirname readlink \
         realpath find xargs tar gzip gunzip touch stat du df ps kill; do \
         [ -e "./$applet" ] || ln -s busybox "./$applet" ; \
    done ; \
    ls -la /bundle/bin/ | head -30

# --- Apptainer startscript: если передана команда (`instance start … CMD`),
# --- выполняем её. Иначе — висим, чтобы instance жил.
RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# ========== Stage 3: final scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

ENV GIT_EXEC_PATH=/usr/libexec/git-core
ENV GIT_SSH_COMMAND=ssh\ -o\ StrictHostKeyChecking=accept-new
ENV GIT_TEMPLATE_DIR=/usr/share/git-core/templates
ENV HOME=/work

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}