# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
#
# Alpine + magicpak + distroless.
# Ставит целевой пакет в builder, magicpak в collector собирает только
# необходимые .so, финал — scratch. Работает для:
#   * ELF-динамических бинарей (nasm, angie, jq, git)
#   * статических бинарей (uv musl, minikube) — через --experimental-noload-resolver.
# Не работает для языков с stdlib в .a (go, rust, python) — им нужен
# apk --root, см. шаблон "alpine".

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder

# Целевой пакет из Alpine-репозитория.
# Для [build.source] в режиме binary/tar ничего не ставим — источник
# скачается отдельным шагом.
#
# ВАЖНО: хвостовой `\` ставится ТОЛЬКО между пакетами. Если оставить
# его после последнего, buildah склеит этот RUN со следующей непустой
# строкой (`FROM builder AS collector`) — второй stage исчезнет, и
# `COPY --from=1` упадёт с "no stage or image found".
{% if not build.source.url %}
{% if build.apt.extra %}
RUN apk add --no-cache \
{%- for p in build.apt.extra %}
        {{ p }}{% if not loop.last %} \{% endif %}
{%- endfor %}

{% else %}
RUN true

{% endif %}
{% endif %}

{% if build.source.url %}
RUN apk add --no-cache ca-certificates wget \
{%- for p in build.apt.extra %}
        {{ p }} \
{%- endfor %}
    && rm -rf /var/cache/apk/*

ARG SRC_URL={{ source_url }}

{% if build.source.type == "binary" %}
RUN set -e ; \
    DEST="{{ build.source.dest | default("/usr/local/bin/tool") }}" ; \
    mkdir -p "$(dirname "$DEST")" ; \
    wget -q -O "$DEST" "$SRC_URL" ; \
    chmod +x "$DEST" ; \
    ls -la "$DEST"

{% elif build.source.type == "tar" or build.source.type == "tgz" or build.source.type == "targz" %}
RUN set -e ; \
    wget -q -O /tmp/pkg.tar.gz "$SRC_URL" ; \
    mkdir -p "{{ build.source.extract_to | default("/usr/local") }}" ; \
    tar -xzf /tmp/pkg.tar.gz \
        -C "{{ build.source.extract_to | default("/usr/local") }}" \
{%- if build.source.strip_components %}
        --strip-components={{ build.source.strip_components }} \
{%- endif %}
    ; \
    rm -f /tmp/pkg.tar.gz

{% elif build.source.type == "deb" %}
RUN set -e ; \
    wget -q -O /tmp/pkg.deb "$SRC_URL" ; \
    apk add --no-cache dpkg ; \
    dpkg-deb -x /tmp/pkg.deb / ; \
    rm -f /tmp/pkg.deb

{% elif build.source.type == "rpm" %}
RUN set -e ; \
    wget -q -O /tmp/pkg.rpm "$SRC_URL" ; \
    apk add --no-cache rpm2cpio cpio ; \
    mkdir -p /tmp/x ; cd /tmp/x ; \
    rpm2cpio /tmp/pkg.rpm | cpio -idmv ; \
    cp -a /tmp/x/* / ; \
    rm -rf /tmp/x /tmp/pkg.rpm

{% endif %}
{% endif %}

# ========== Stage 2: collector (magicpak) ==========
FROM builder AS collector

# build-base: gcc + musl-dev + binutils — magicpak --dynamic компилирует
# LD_PRELOAD-резолвер через cc. Без него "IO error: No such file or directory".
RUN apk add --no-cache \
        build-base \
        ca-certificates \
        wget \
        coreutils

RUN wget -q \
        https://github.com/coord-e/magicpak/releases/download/{{ magicpak_version }}/magicpak-x86_64-unknown-linux-musl \
        -O /usr/bin/magicpak \
    && chmod +x /usr/bin/magicpak

ENV HOME=/tmp/app-home
ENV XDG_RUNTIME_DIR=/tmp/app-runtime
ENV XDG_CONFIG_HOME=/tmp/app-home/.config
ENV XDG_DATA_HOME=/tmp/app-home/.local/share
ENV XDG_CACHE_HOME=/tmp/app-home/.cache

# --- Детектим статический бинарник через file -b и выбираем режим magicpak.
# --- target_args (например, ["-v"]) передаются в target, чтобы он быстро
# --- завершился и magicpak записал /bundle.
RUN mkdir -p "$HOME" "$XDG_RUNTIME_DIR" /bundle \
    && chmod 700 "$XDG_RUNTIME_DIR" \
    && set +e \
    && TARGET="{{ binary | sh_quote }}" ; \
    echo "=== target: $TARGET ===" ; \
#    if file -b "$TARGET" | grep -q 'statically linked' ; then \
        MODE="--experimental-noload-resolver" ; \
#    else \
#        MODE="--dynamic" ; \
#    fi ; \
    echo "=== magicpak mode: $MODE ===" ; \
    echo "=== building include list ===" ; \
    : > /tmp/includes.txt ; \
{%- for inc in build.collect.includes %}
    for f in {{ inc }}; do \
        if [ -f "$f" ]; then \
            echo "$f" >> /tmp/includes.txt ; \
        elif [ -d "$f" ]; then \
            find "$f" -type f >> /tmp/includes.txt ; \
        fi ; \
    done ; \
{%- endfor %}
    set -- ; \
    while IFS= read -r f; do set -- "$@" --include "$f"; done < /tmp/includes.txt ; \
    echo "=== $# include arguments ===" ; \
    timeout --signal=TERM --kill-after=10 {{ collect_timeout }} \
        magicpak $MODE "$@" \
            "$TARGET" \
            /bundle \
{%- if build.collect.target_args %}
            -- \
{%- for arg in build.collect.target_args %}
            {{ arg | sh_quote() }} \
{%- endfor %}
{%- endif %}
            ; \
    rc=$? ; \
    echo "--- magicpak exit=$rc ---" ; \
    ls -la /bundle 2>/dev/null || true ; \
    if [ ! -d /bundle/usr ] && [ ! -d /bundle/lib ] && [ ! -d /bundle/bin ] ; then \
        echo "magicpak produced no usable bundle" >&2 ; \
        exit 1 ; \
    fi ; \
    exit 0

# --- busybox как мульти-applet ---
RUN set -e ; \
    cd /bundle/bin ; \
    if [ ! -x ./busybox ] ; then \
        wget -q "{{ busybox_url }}" -O ./busybox ; \
        chmod +x ./busybox ; \
    fi ; \
    for applet in \
         sh ash cat cp mv rm mkdir rmdir ls ln chmod chown \
         id whoami sed awk grep egrep fgrep tr cut head tail \
         sort uniq tee echo printf sleep true false test env \
         printenv date hostname uname basename dirname readlink \
         realpath find xargs tar gzip gunzip touch stat du df ps kill; do \
         [ -e "./$applet" ] || ln -s busybox "./$applet" ; \
    done ; \
    ls -la /bundle/bin/ | head -20

# --- Apptainer startscript: если передана команда (`instance start … CMD`),
# --- выполняем её. Иначе — висим, чтобы instance жил.
RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# ========== Stage 3: distroless scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}