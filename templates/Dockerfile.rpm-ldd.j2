# syntax=docker/dockerfile:1
# Auto-generated by appspec from pkg.name pkg.version — DO NOT EDIT
#
# Template: "rpm-ldd" — статический сборщик зависимостей для RPM-based
# дистрибутивов (Fedora / ROSA / ALT / openSUSE / AlmaLinux / RHEL).
#
# ВАЖНО: flags из [build.pkg_ops] собираются через namespace() — в minijinja
# обычный set внутри for НЕ мутирует внешнюю переменную (loop-local scope).
# Флаги рендерятся inline, без backslash на пустых строках.
#
# ВАЖНО: в Dockerfile-комментариях НЕЛЬЗЯ использовать jinja-синтаксис
# (процент-скобки, двойные фигурные скобки) — minijinja обрабатывает его
# даже внутри строк, начинающихся с решётки. Примеры jinja — только в
# raw-блоках или перефразировать текстом.

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder

ARG PKG_MGR=auto

# --- Сборка флагов из [build.pkg_ops] в namespace.
{%- set ns = namespace(dnf="", urpmi="", zypper="", weak=false, enable="") %}
{%- for op in build.pkg_ops %}
{%-   if op.op == "disable_repo" %}
{%-     set ns.dnf = ns.dnf ~ "--disablerepo=" ~ op.name ~ " " %}
{%-     set ns.zypper = ns.zypper ~ "--disablerepo=" ~ op.name ~ " " %}
{%-     set ns.urpmi = ns.urpmi ~ "--excludemedia=" ~ op.name ~ " " %}
{%-   elif op.op == "exclude_pkg" %}
{%-     set ns.dnf = ns.dnf ~ "--exclude=" ~ op.name ~ " " %}
{%-     set ns.zypper = ns.zypper ~ "-x " ~ op.name ~ " " %}
{%-     set ns.urpmi = ns.urpmi ~ "--skip " ~ op.name ~ " " %}
{%-   elif op.op == "disable_weak_deps" %}
{%-     set ns.weak = true %}
{%-   elif op.op == "enable_repo" %}
{%-     set ns.enable = ns.enable ~ op.name ~ " " %}
{%-   endif %}
{%- endfor %}

{%- if ns.enable %}
# --- Включаем репозитории из [build.pkg_ops].enable_repo.
# dnf-plugins-core даёт `dnf config-manager`. epel-release нужен для
# репо `epel` (AlmaLinux/RHEL). Ставим его только если epel в списке.
RUN set -eu ; \
    dnf install -y --setopt=install_weak_deps=False dnf-plugins-core ; \
    {%- if "epel" in ns.enable %}
    dnf install -y --setopt=install_weak_deps=False epel-release ; \
    {%- endif %}
    dnf config-manager --set-enabled {{ ns.enable }}
{%- endif %}

# --- Базовые утилиты + GUI-библиотеки для ldd-сборки.
RUN set -eu ; \
    PKG_MGR="${PKG_MGR:-auto}" ; \
    if [ "$PKG_MGR" = "auto" ] ; then \
        if command -v dnf >/dev/null 2>&1 ; then PKG_MGR=dnf ; \
        elif command -v microdnf >/dev/null 2>&1 ; then PKG_MGR=microdnf ; \
        elif command -v urpmi >/dev/null 2>&1 ; then PKG_MGR=urpmi ; \
        elif command -v zypper >/dev/null 2>&1 ; then PKG_MGR=zypper ; \
        else echo "unsupported: no dnf/microdnf/urpmi/zypper" >&2 ; exit 1 ; fi ; \
    fi ; \
    echo "using package manager: $PKG_MGR" ; \
    case "$PKG_MGR" in \
        dnf|microdnf) \
            set -x ; \
            $PKG_MGR install -y {% if ns.weak %}--setopt=install_weak_deps=False {% endif %}{{ ns.dnf }}ca-certificates wget file binutils patchelf \
                glibc libstdc++ libgcc \
                mesa-libGL \
                libX11 libXext libXrender libXtst libXi libXrandr \
                libXcursor libXcomposite libXdamage libXfixes \
                libxkbcommon gtk3 \
                alsa-lib nss nspr dbus-libs fontconfig \
                dejavu-sans-fonts \
                {%- for p in build.apt.extra %}
                {{ p }} \
                {%- endfor %}
                ; $PKG_MGR clean all 2>/dev/null || true ;; \
        urpmi) \
            set -x ; \
            urpmi --auto {% if ns.weak %}--no-suggests {% endif %}{{ ns.urpmi }}ca-certificates wget file binutils patchelf \
                glibc libstdc++ libgcc \
                libmesaegl libmesagl1 \
                libx11_6 libxext6 libxrender1 libxtst6 libxi6 libxrandr2 \
                libxcursor1 libxcomposite1 libxdamage1 libxfixes3 \
                libxkbcommon gtk+3.0 libgdk-pixbuf2.0_0 libpango1.0_0 libcairo2 \
                libalsa2 libnss3 libnspr4 libdbus-1_3 fontconfig \
                fonts-ttf-dejavu \
                {%- for p in build.apt.extra %}
                {{ p }} \
                {%- endfor %}
                ; urpmi --clean 2>/dev/null || true ;; \
        zypper) \
            set -x ; \
            zypper --non-interactive install {% if ns.weak %}--no-recommends {% endif %}{{ ns.zypper }}ca-certificates wget file binutils patchelf \
                glibc libstdc++6 libgcc_s1 \
                Mesa-libGL1 Mesa-libEGL1 \
                libX11-6 libXext6 libXrender1 libXtst6 libXi6 libXrandr2 \
                libXcursor1 libXcomposite1 libXdamage1 libXfixes3 \
                libxkbcommon0 gtk3 gdk-pixbuf2 pango cairo \
                alsa-lib mozilla-nss mozilla-nspr libdbus-1-3 fontconfig \
                dejavu-fonts \
                {%- for p in build.apt.extra %}
                {{ p }} \
                {%- endfor %}
                ; zypper clean 2>/dev/null || true ;; \
        *) echo "unsupported package manager: $PKG_MGR" >&2 ; exit 1 ;; \
    esac

# --- Установка целевого пакета.
{% if build.source.type == "repo" %}
RUN set -eu ; \
    PKG_MGR="${PKG_MGR:-auto}" ; \
    if [ "$PKG_MGR" = "auto" ] ; then \
        if command -v dnf >/dev/null 2>&1 ; then PKG_MGR=dnf ; \
        elif command -v microdnf >/dev/null 2>&1 ; then PKG_MGR=microdnf ; \
        elif command -v urpmi >/dev/null 2>&1 ; then PKG_MGR=urpmi ; \
        elif command -v zypper >/dev/null 2>&1 ; then PKG_MGR=zypper ; \
        else echo "unsupported" >&2 ; exit 1 ; fi ; \
    fi ; \
    echo "=== installing from repo: {{ build.source.package | default(value="<empty!>") }} (pkg_mgr=$PKG_MGR) ===" ; \
    case "$PKG_MGR" in \
        dnf|microdnf) \
            set -x ; \
            $PKG_MGR install -y {% if ns.weak %}--setopt=install_weak_deps=False {% endif %}{{ ns.dnf }}{{ build.source.package }} ;; \
        urpmi) \
            set -x ; \
            urpmi --auto {% if ns.weak %}--no-suggests {% endif %}{{ ns.urpmi }}{{ build.source.package }} ;; \
        zypper) \
            set -x ; \
            zypper --non-interactive install {% if ns.weak %}--no-recommends {% endif %}{{ ns.zypper }}{{ build.source.package }} ;; \
    esac ; \
    $PKG_MGR clean all 2>/dev/null || true ; \
    echo "=== installed binary ===" ; \
    ls -la {{ binary | sh_quote }} 2>&1 || echo "(NOT FOUND!)"
{% elif build.source.skip_depends %}
# skip_depends: ставим .rpm БЕЗ разрешения зависимостей.
# Все зависимости — в [build.apt].extra (уже установлены выше).
# Это обходит транзитивные зависимости, недоступные в регионе.
#
# ВАЖНО: AlmaLinux 9 dnf НЕ поддерживает `--no-deps`. Используем
# `rpm -i --nodeps` для dnf/microdnf/rpm. zypper — force-resolution,
# urpmi — --allow-nodeps.
ARG SRC_URL={{ source_url }}
RUN set -eu ; \
    wget -q -O /tmp/pkg.rpm "$SRC_URL" ; \
    rpm -qip /tmp/pkg.rpm | head -20 ; \
    du -h /tmp/pkg.rpm ; \
    PKG_MGR="${PKG_MGR:-auto}" ; \
    if [ "$PKG_MGR" = "auto" ] ; then \
        if command -v dnf >/dev/null 2>&1 ; then PKG_MGR=dnf ; \
        elif command -v microdnf >/dev/null 2>&1 ; then PKG_MGR=microdnf ; \
        elif command -v urpmi >/dev/null 2>&1 ; then PKG_MGR=urpmi ; \
        elif command -v zypper >/dev/null 2>&1 ; then PKG_MGR=zypper ; \
        else PKG_MGR=rpm ; fi ; \
    fi ; \
    echo "=== installing /tmp/pkg.rpm (skip_depends, pkg_mgr=$PKG_MGR) ===" ; \
    case "$PKG_MGR" in \
        dnf|microdnf) rpm -i --nodeps /tmp/pkg.rpm ;; \
        urpmi) urpmi --auto --allow-nodeps /tmp/pkg.rpm ;; \
        zypper) zypper --non-interactive --no-recommends --force-resolution install /tmp/pkg.rpm ;; \
        rpm) rpm -i --nodeps /tmp/pkg.rpm ;; \
    esac ; \
    rm -f /tmp/pkg.rpm ; \
    echo "=== installed binary ===" ; \
    ls -la {{ binary | sh_quote }} 2>&1 || echo "(NOT FOUND!)" ; \
    if [ -e {{ binary | sh_quote }} ] ; then \
        echo -n "  magic: " ; head -c 4 {{ binary | sh_quote }} | od -An -c | head -1 ; \
    fi
{% else %}
ARG SRC_URL={{ source_url }}
RUN set -eu ; \
    PKG_MGR="${PKG_MGR:-auto}" ; \
    if [ "$PKG_MGR" = "auto" ] ; then \
        if command -v dnf >/dev/null 2>&1 ; then PKG_MGR=dnf ; \
        elif command -v microdnf >/dev/null 2>&1 ; then PKG_MGR=microdnf ; \
        elif command -v urpmi >/dev/null 2>&1 ; then PKG_MGR=urpmi ; \
        elif command -v zypper >/dev/null 2>&1 ; then PKG_MGR=zypper ; \
        else echo "unsupported" >&2 ; exit 1 ; fi ; \
    fi ; \
    wget -q -O /tmp/pkg.rpm "$SRC_URL" ; \
    rpm -qip /tmp/pkg.rpm | head -20 ; \
    du -h /tmp/pkg.rpm ; \
    case "$PKG_MGR" in \
        dnf|microdnf) \
            set -x ; \
            $PKG_MGR install -y {% if ns.weak %}--setopt=install_weak_deps=False {% endif %}{{ ns.dnf }}/tmp/pkg.rpm ;; \
        urpmi) \
            set -x ; \
            urpmi --auto {% if ns.weak %}--no-suggests {% endif %}{{ ns.urpmi }}/tmp/pkg.rpm ;; \
        zypper) \
            set -x ; \
            zypper --non-interactive install {% if ns.weak %}--no-recommends {% endif %}{{ ns.zypper }}/tmp/pkg.rpm ;; \
    esac ; \
    rm -f /tmp/pkg.rpm ; \
    echo "=== installed binary ===" ; \
    ls -la {{ binary | sh_quote }} 2>&1 || echo "(NOT FOUND!)" ; \
    if [ -e {{ binary | sh_quote }} ] ; then \
        echo -n "  magic: " ; head -c 4 {{ binary | sh_quote }} | od -An -c | head -1 ; \
    fi
{% endif %}

# --- Триггеры gschemas / pixbuf / gio / mime / fontconfig.
RUN set -eu ; \
    if command -v glib-compile-schemas >/dev/null 2>&1 \
       && [ -d /usr/share/glib-2.0/schemas ] ; then \
        glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true ; \
    fi ; \
    if command -v gdk-pixbuf-query-loaders >/dev/null 2>&1 \
       && [ -d /usr/lib64/gdk-pixbuf-2.0/2.10.0/loaders ] ; then \
        gdk-pixbuf-query-loaders > /usr/lib64/gdk-pixbuf-2.0/2.10.0/loaders.cache 2>/dev/null || true ; \
    fi ; \
    if command -v gio-querymodules >/dev/null 2>&1 \
       && [ -d /usr/lib64/gio/modules ] ; then \
        gio-querymodules /usr/lib64/gio/modules 2>/dev/null || true ; \
    fi ; \
    if command -v update-mime-database >/dev/null 2>&1 \
       && [ -d /usr/share/mime ] ; then \
        update-mime-database /usr/share/mime 2>/dev/null || true ; \
    fi ; \
    if command -v fc-cache >/dev/null 2>&1 ; then \
        fc-cache -f 2>/dev/null || true ; \
    fi

# ========== Stage 2: collector — ldd ==========
FROM builder AS collector

# --- Collector stage: coreutils/findutils/gawk, только если их нет.
# В AlmaLinux 9 minimal базовые утилиты предоставляет coreutils-single,
# который конфликтует с полным coreutils. Проверка command -v избегает
# бесполезной установки, --allowerasing решает конфликт в редких случаях.
# Collector stage — disposable: coreutils-single можно заменить без
# последствий для финального scratch-образа.
RUN set -eu ; \
    if ! command -v find >/dev/null 2>&1 \
       || ! command -v sort >/dev/null 2>&1 \
       || ! command -v awk  >/dev/null 2>&1 ; then \
        if command -v dnf >/dev/null 2>&1 ; then \
            dnf install -y --allowerasing coreutils findutils gawk ; \
        elif command -v urpmi >/dev/null 2>&1 ; then \
            urpmi --auto coreutils findutils gawk ; \
        elif command -v zypper >/dev/null 2>&1 ; then \
            zypper --non-interactive install --no-recommends coreutils findutils gawk ; \
        else echo "unsupported" >&2 ; exit 1 ; fi ; \
    fi ; \
    rm -rf /var/cache/dnf/* /var/cache/urpmi/* /var/cache/zypp/* 2>/dev/null || true

# --- helper: копирует файл в /bundle с сохранением пути и разыменованием симлинков
RUN cat > /usr/local/bin/bundle-copy.sh <<'BCEOF'
#!/bin/sh
set -eu
bundle_copy() {
    f="$1"
    if [ ! -e "$f" ] && [ ! -L "$f" ]; then
        return 0
    fi
    cp -aL --parents "$f" /bundle 2>/dev/null || true
}
for arg in "$@"; do
    bundle_copy "$arg"
done
BCEOF
RUN chmod +x /usr/local/bin/bundle-copy.sh

# --- ELF-таргеты: бинарник + plugin .so (Qt5/6, GStreamer, GIO, GTK).
RUN set -eu ; \
    : > /tmp/targets.txt ; \
    TARGET="{{ binary | sh_quote }}" ; \
    echo "$TARGET" >> /tmp/targets.txt ; \
    for d in \
        /usr/lib64/qt6/plugins /usr/lib64/qt6/libexec \
        /usr/lib64/qt5/plugins /usr/lib64/qt5/libexec \
        /usr/lib/x86_64-linux-gnu/qt6/plugins \
        /usr/lib/x86_64-linux-gnu/qt5/plugins \
        /usr/lib64/gstreamer-1.0 /usr/lib64/gstreamer-0.10 \
        /usr/libexec/gstreamer-1.0 \
        /usr/lib64/gio/modules \
        /usr/lib64/gtk-3.0 /usr/lib64/gtk-4.0 \
        /usr/lib64/gdk-pixbuf-2.0 /usr/lib64/pango \
        /usr/lib64/enchant-2 /usr/lib64/libproxy /usr/lib64/spa-0.2 \
    ; do \
        [ -d "$d" ] || continue ; \
        find "$d" -type f \( -name '*.so' -o -name '*.so.*' \) \
            >> /tmp/targets.txt ; \
    done ; \
    sort -u /tmp/targets.txt -o /tmp/targets.txt ; \
    echo "=== targets: $(wc -l < /tmp/targets.txt) ===" ; \
    head -20 /tmp/targets.txt

# --- ldd по каждому таргету, bundle-copy
RUN set -eu ; \
    mkdir -p /bundle ; \
    while IFS= read -r t ; do \
        [ -f "$t" ] || continue ; \
        /usr/local/bin/bundle-copy.sh "$t" ; \
        ldd "$t" 2>/dev/null \
            | awk '/=> \// {print $3} /^\// {print $1}' \
            | while IFS= read -r lib ; do \
                [ -f "$lib" ] || continue ; \
                /usr/local/bin/bundle-copy.sh "$lib" ; \
            done ; \
    done < /tmp/targets.txt ; \
    echo "=== /bundle after ldd ===" ; \
    du -sh /bundle

# --- Патч ELF interpreter: execve() откроет PT_INTERP БУКВАЛЬНО.
RUN set -eu ; \
    BIN="{{ binary | sh_quote }}" ; \
    if [ ! -e "/bundle$BIN" ] || ! head -c 4 "/bundle$BIN" 2>/dev/null | grep -q ELF ; \
        then echo "  not ELF (wrapper or missing), skip interpreter patch" ; exit 0 ; \
    fi ; \
    INTERP=$(grep -aoE '/lib(64)?/[a-zA-Z0-9._-]+/(ld-[a-zA-Z0-9._-]+|ld\.so\.[0-9]+|ld-musl-[a-zA-Z0-9._-]+)' "/bundle$BIN" 2>/dev/null | head -1 || true) ; \
    if [ -z "${INTERP:-}" ] ; then \
        INTERP=$(grep -aoE '/lib(64)?/(ld-[a-zA-Z0-9._-]+|ld\.so\.[0-9]+|ld-musl-[a-zA-Z0-9._-]+)' "/bundle$BIN" 2>/dev/null | head -1 || true) ; \
    fi ; \
    echo "  PT_INTERP from binary: ${INTERP:-<undetermined>}" ; \
    for p in \
        "${INTERP:-/nonexistent}" \
        /lib64/ld-linux-x86-64.so.2 \
        /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 \
        /lib64/ld-linux-aarch64.so.1 \
        /lib/ld-linux-aarch64.so.1 \
        /lib64/ld-linux.so.2 \
    ; do \
        [ -e "$p" ] || continue ; \
        real=$(readlink -f "$p" 2>/dev/null || true) ; \
        [ -e "$real" ] || continue ; \
        mkdir -p "/bundle$(dirname "$p")" ; \
        rm -f "/bundle$p" ; \
        cp -L "$real" "/bundle$p" ; \
        chmod 755 "/bundle$p" ; \
        echo "  + interpreter: $p -> $real" ; \
    done ; \
    for leaf in /lib64/ld-2.*.so /usr/lib64/ld-2.*.so /lib/ld-2.*.so ; do \
        [ -e "$leaf" ] || continue ; \
        real=$(readlink -f "$leaf" 2>/dev/null || true) ; \
        [ -e "$real" ] || continue ; \
        mkdir -p "/bundle$(dirname "$leaf")" ; \
        cp -L "$real" "/bundle$leaf" 2>/dev/null || true ; \
    done

# --- Верификация бинарника: fallback-поиск + проверка ELF.
RUN set -eu ; \
    BIN="{{ binary | sh_quote }}" ; \
    if [ ! -e "/bundle$BIN" ] && [ ! -L "/bundle$BIN" ] ; then \
        echo "WARN: $BIN отсутствует в /bundle — ищу альтернативу" ; \
        BN="$(basename "$BIN")" ; \
        ALT="$(find /usr/bin /usr/sbin /usr/lib /usr/lib64 /usr/libexec /opt /usr/share \
                    -maxdepth 6 -type f -name "$BN" 2>/dev/null | head -1)" ; \
        if [ -z "$ALT" ] ; then \
            echo "ERROR: '$BN' не найден в builder." >&2 ; \
            ls /usr/bin/ 2>&1 | head -30 >&2 ; \
            exit 1 ; \
        fi ; \
        echo "  found: $ALT" ; \
        /usr/local/bin/bundle-copy.sh "$ALT" ; \
        ldd "$ALT" 2>/dev/null \
            | awk '/=> \// {print $3} /^\// {print $1}' \
            | while IFS= read -r lib ; do \
                [ -f "$lib" ] || continue ; \
                /usr/local/bin/bundle-copy.sh "$lib" ; \
            done ; \
    fi ; \
    if [ -e "/bundle$BIN" ] && ! head -c 4 "/bundle$BIN" 2>/dev/null | grep -q ELF ; then \
        echo "WARN: $BIN не ELF — вероятно shell wrapper" ; \
        BN="$(basename "$BIN")" ; \
        for cand in /usr/libexec/$BN /usr/lib/$BN /opt/$BN ; do \
            if [ -f "$cand" ] ; then \
                echo "  found real: $cand" ; \
                /usr/local/bin/bundle-copy.sh "$cand" ; \
                ldd "$cand" 2>/dev/null \
                    | awk '/=> \// {print $3} /^\// {print $1}' \
                    | while IFS= read -r lib ; do \
                        [ -f "$lib" ] || continue ; \
                        /usr/local/bin/bundle-copy.sh "$lib" ; \
                    done ; \
            fi ; \
        done ; \
    fi

# --- Системные файлы, без которых ELF не запустится.
RUN set -eu ; \
    mkdir -p /bundle/etc /bundle/etc/ld.so.conf.d ; \
    if [ -f /etc/ld.so.cache ]; then cp -a /etc/ld.so.cache /bundle/etc/ld.so.cache ; fi ; \
    if [ -f /etc/ld.so.conf ]; then cp -a /etc/ld.so.conf /bundle/etc/ld.so.conf ; fi ; \
    if [ -d /etc/ld.so.conf.d ]; then cp -a /etc/ld.so.conf.d/. /bundle/etc/ld.so.conf.d/ 2>/dev/null || true ; fi ; \
    printf '%s\n' '/usr/lib64' '/usr/lib' '/lib64' '/lib' \
        > /bundle/etc/ld.so.conf.d/rpm-ldd.conf ; \
    printf 'passwd: files\ngroup: files\nhosts: files dns\n' > /bundle/etc/nsswitch.conf ; \
    printf 'root:x:0:0:root:/root:/bin/sh\n' > /bundle/etc/passwd ; \
    printf 'root:x:0:\n' > /bundle/etc/group ; \
    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then \
        mkdir -p /bundle/etc/ssl/certs ; \
        cp -a /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/certs/ ; \
        ln -sf /etc/ssl/certs/ca-certificates.crt /bundle/etc/ssl/cert.pem ; \
    elif [ -d /etc/pki/ca-trust ] ; then \
        mkdir -p /bundle/etc/pki ; \
        cp -aL /etc/pki/ca-trust /bundle/etc/pki/ 2>/dev/null || true ; \
        rm -rf /bundle/etc/pki/ca-trust/extracted/pem/directory-hash ; \
    fi

# --- GUI-ресурсы: fontconfig, шрифты, xdg, иконки, gschemas, pixbuf, gio.
RUN set -eu ; \
    for d in /etc/fonts /usr/share/fonts /etc/xdg /usr/share/icons \
             /usr/share/glib-2.0/schemas \
             /usr/lib64/gdk-pixbuf-2.0/2.10.0 \
             /usr/lib64/gio/modules /usr/share/mime /usr/share/icons/hicolor ; do \
        [ -d "$d" ] || continue ; \
        mkdir -p "/bundle$d" ; cp -a "$d/." "/bundle$d/" ; \
        echo "  + resource dir: $d" ; \
    done ; \
    for d in /usr/lib64/qt6/qml /usr/lib64/qt5/qml \
             /usr/share/qt6/translations /usr/share/qt5/translations \
             /usr/share/qt6/resources /usr/share/qt5/resources ; do \
        [ -d "$d" ] || continue ; \
        mkdir -p "/bundle$d" ; cp -a "$d/." "/bundle$d/" ; \
        echo "  + qt resource dir: $d" ; \
    done ; \
    du -sh /bundle

# --- Пересобрать ld.so.cache для /bundle (best-effort).
RUN if command -v ldconfig >/dev/null 2>&1 && [ -f /bundle/etc/ld.so.conf ] ; then \
        ldconfig -r /bundle 2>/dev/null || true ; \
        echo "=== ldconfig check ===" ; \
        ldconfig -r /bundle -p 2>/dev/null | head -20 || true ; \
    fi

# --- bash и dash + их .so (libtinfo, libncursesw и т.д.).
RUN set -eu ; \
    for sh in /bin/bash /bin/dash ; do \
        [ -e "$sh" ] || continue ; \
        real=$(readlink -f "$sh") ; \
        base=$(basename "$sh") ; \
        mkdir -p /bundle/bin ; \
        cp -L "$real" "/bundle/bin/$base" ; \
        chmod 755 "/bundle/bin/$base" ; \
        ldd "$real" 2>/dev/null \
            | awk '/=> \// {print $3} /^\// {print $1}' \
            | while IFS= read -r lib ; do \
                [ -f "$lib" ] || continue ; \
                /usr/local/bin/bundle-copy.sh "$lib" ; \
            done ; \
        echo "  + /bundle/bin/$base (+deps)" ; \
    done

# --- Опциональные includes из спека (глобы раскрываются shell-ом).
RUN set -eu ; \
{%- if build.collect.includes %}
    for g in \
{%- for inc in build.collect.includes %}
        "{{ inc }}" \
{%- endfor %}
    ; do \
        for f in $g ; do \
            if [ -e "$f" ] || [ -L "$f" ]; then \
                /usr/local/bin/bundle-copy.sh "$f" ; \
            elif [ -d "$f" ]; then \
                find "$f" \( -type f -o -type l \) \
                    | while IFS= read -r sub ; do \
                        /usr/local/bin/bundle-copy.sh "$sub" ; \
                    done ; \
            fi ; \
        done ; \
    done ; \
{%- endif %}
    echo "=== /bundle after includes ===" ; du -sh /bundle

# --- busybox + symlinks (нужен /bin/sh для setup и instance start).
RUN set -eu ; \
    mkdir -p /bundle/bin ; \
    wget -q "{{ busybox_url }}" -O /bundle/bin/busybox ; \
    chmod +x /bundle/bin/busybox ; \
    cd /bundle/bin ; \
    for applet in \
         sh ash cat cp mv rm mkdir rmdir ls ln chmod chown \
         id whoami sed awk grep egrep fgrep tr cut head tail \
         sort uniq tee echo printf sleep true false test env \
         printenv date hostname uname basename dirname readlink \
         realpath find xargs tar gzip gunzip touch stat du df ps kill \
         expr od hexdump; do \
         [ -e "./$applet" ] || ln -s busybox "./$applet" ; \
    done ; \
    ls -la /bundle/bin/ | head -25

# --- Apptainer startscript.
RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# --- Финальная диагностика.
RUN echo "=== final bundle size ===" ; du -sh /bundle ; \
    echo "=== target binary ===" ; \
    ls -la "{{ binary | sh_quote }}" 2>/dev/null || true ; \
    echo "=== interpreters ===" ; \
    ls -la /bundle/lib64/ld-* /bundle/lib/x86_64-linux-gnu/ld-* 2>/dev/null || true

# ========== Stage 3: final scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}