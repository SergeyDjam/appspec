# ========== Базовый образ ==========
FROM {{ build.base }}

# --- budtmo/docker-android заканчивается USER android — без root
# --- нельзя писать в /opt (Permission denied на printf).
USER root

# --- xkb + Qt6-xcb: без libxkbcommon-x11-0 Qt6 на xcb не преобразует
# --- клавиши в evdev для гостя. budtmo собран под Xvfb+noVNC, где
# --- клавиатура шла через браузер.
RUN set -eu ; \
    if command -v apt-get >/dev/null 2>&1 ; then \
        apt-get update ; \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
            xkb-data \
            libxkbcommon0 \
            libxkbcommon-x11-0 \
            x11-xkb-utils \
            x11-utils ; \
        rm -rf /var/lib/apt/lists/* ; \
    fi ; \
    echo "=== libxkbcommon ===" ; \
    ldconfig -p 2>/dev/null | grep -E "libxkbcommon" || true ; \
    echo "=== bundled libqxcb deps ===" ; \
    for f in $(find /opt/android/emulator -name "libqxcb.so" 2>/dev/null) ; do \
        ldd "$f" 2>/dev/null | grep -E "xkb|not found" || true ; \
    done

# --- Генерация start-x11-emulator.sh.
# --- Скрипт inline (printf), а не COPY: appspec не копирует
# --- templates/ в build context.
RUN set -eu ; \
    mkdir -p /opt /opt/extensions ; \
    printf '%s\n' \
        '#!/bin/bash' \
        'set -euo pipefail' \
        '' \
        '# 1. Сброс хостовых env. ANDROID_SDK_ROOT с хоста может указывать' \
        '#    на /mnt/cl/chroot/... путь, которого в контейнере нет.' \
        '#    Реальный SDK — /opt/android (зашит в budtmo/docker-android).' \
        'unset ANDROID_SDK_ROOT ANDROID_HOME \' \
        '      ANDROID_NDK_ROOT ANDROID_NDK_HOME \' \
        '      ANDROID_NDK_PLATFORM ANDROID_NDK_HOST' \
        'export ANDROID_SDK_ROOT=/opt/android' \
        'export ANDROID_HOME=/opt/android' \
        'export PATH="/opt/android/emulator:/opt/android/platform-tools:/opt/android/cmdline-tools/tools/bin:$PATH"' \
        '' \
        '# 2. xkb: Qt6 xcb берёт раскладку из X11 через XKB extension.' \
        'export XKB_CONFIG_ROOT=/usr/share/X11/xkb' \
        'export QT_XKB_CONFIG_ROOT=/usr/share/X11/xkb' \
        '' \
        '# 3. HOME должен быть writable. Под --fakeroot это /root,' \
        '#    иначе (plain exec) — /tmp.' \
        'export HOME="${HOME:-/root}"' \
        '[ -w "$HOME" ] || export HOME=/tmp' \
        '' \
        '# 4. Сброс AVD-переменных. ANDROID_AVD_HOME / ANDROID_USER_HOME могут' \
        '#    приходить с хоста (--contain не чистит env), и тогда avdmanager' \
        '#    создаёт AVD мимо $HOME/.android/avd/.' \
        'unset ANDROID_AVD_HOME ANDROID_USER_HOME ANDROID_SDK_HOME ANDROID_PREFS_ROOT 2>/dev/null || true' \
        'export ANDROID_AVD_HOME="$HOME/.android/avd"' \
        'mkdir -p "$ANDROID_AVD_HOME"' \
        '' \
        '# 5. Убиваем Xvfb/x11vnc от штатного entrypoint budtmo,' \
        '#    чтобы освободить display для хостового X11.' \
        'pkill -f Xvfb 2>/dev/null || true' \
        'pkill -f x11vnc 2>/dev/null || true' \
        'sleep 1' \
        '' \
        '# 6. DISPLAY должен быть проброшен с хоста.' \
        'if [ -z "${DISPLAY:-}" ]; then' \
        '    echo "ERROR: DISPLAY не установлен. Пробросьте X11 (binds /tmp/.X11-unix)." >&2' \
        '    exit 1' \
        'fi' \
        'export DISPLAY' \
        '' \
        '# 7. Поиск AVD. Если нет — создаём из первого x86_64 system-image.' \
        'echo "=== emulator -list-avds ===" >&2' \
        'emulator -list-avds >&2 2>&1 || true' \
        'AVD_NAME=$(emulator -list-avds 2>/dev/null | head -n1 || true)' \
        '' \
        'if [ -z "$AVD_NAME" ]; then' \
        '    echo "=== AVD not found, creating from system-images ===" >&2' \
        '    SYSIMG=$(find /opt/android/system-images -mindepth 3 -maxdepth 3 -type d -name "x86_64" 2>/dev/null | head -1 || true)' \
        '    if [ -z "$SYSIMG" ]; then' \
        '        echo "ERROR: system-image (x86_64) не найден в /opt/android/system-images" >&2' \
        '        find /opt/android/system-images -maxdepth 4 -type d >&2 2>&1 || true' \
        '        exit 1' \
        '    fi' \
        '    SYSIMG_KEY=$(echo "$SYSIMG" | sed "s|/opt/android/||; s|/|;|g")' \
        '    echo "Creating AVD with system-image: $SYSIMG_KEY" >&2' \
        '    AVD_NAME=appspec_avd' \
        '    echo no | avdmanager create avd -n "$AVD_NAME" -k "$SYSIMG_KEY" --force 2>&1' \
        '    AVD_RC=$?' \
        '    if [ "$AVD_RC" -ne 0 ]; then' \
        '        echo "ERROR: avdmanager create failed (rc=$AVD_RC)" >&2' \
        '    fi' \
        '' \
        '    # Проверяем через emulator, а не через config.ini: config.ini может' \
        '    # оказаться не там, где мы ожидаем.' \
        '    if ! emulator -list-avds 2>/dev/null | grep -qx "$AVD_NAME"; then' \
        '        echo "ERROR: AVD $AVD_NAME не виден emulator после create" >&2' \
        '        echo "--- diag: ANDROID_AVD_HOME=$ANDROID_AVD_HOME ---" >&2' \
        '        ls -la "$ANDROID_AVD_HOME" 2>&1 >&2 || true' \
        '        echo "--- diag: HOME/.android ---" >&2' \
        '        ls -la "$HOME/.android" 2>&1 >&2 || true' \
        '        echo "--- diag: поиск config.ini ---" >&2' \
        '        find "$HOME" /root /tmp -name "config.ini" -path "*.avd/*" 2>/dev/null >&2 || true' \
        '        exit 1' \
        '    fi' \
        '' \
        '    # Патч hw.keyboard: ищем config.ini фактически, а не по угаданному пути.' \
        '    AVD_CFG=$(find "$ANDROID_AVD_HOME" -path "*/${AVD_NAME}.avd/config.ini" 2>/dev/null | head -1 || true)' \
        '    if [ -z "$AVD_CFG" ]; then' \
        '        AVD_CFG=$(find "$HOME" /root -name "config.ini" -path "*.avd/*" 2>/dev/null | head -1 || true)' \
        '    fi' \
        '    if [ -n "$AVD_CFG" ] && [ -f "$AVD_CFG" ]; then' \
        '        if grep -q "^hw.keyboard" "$AVD_CFG"; then' \
        '            sed -i "s/^hw.keyboard.*/hw.keyboard=yes/" "$AVD_CFG"' \
        '        else' \
        '            echo "hw.keyboard=yes" >> "$AVD_CFG"' \
        '        fi' \
        '        grep -q "^hw.keyboard.lid" "$AVD_CFG" || echo "hw.keyboard.lid=no" >> "$AVD_CFG"' \
        '        echo "Patched $AVD_CFG:" >&2' \
        '        grep -E "^hw.keyboard" "$AVD_CFG" >&2 || true' \
        '    else' \
        '        echo "WARN: config.ini not found anywhere; hw.keyboard не пропатчен" >&2' \
        '    fi' \
        'fi' \
        '' \
        '# 8. Финальная проверка AVD.' \
        'if [ -z "$AVD_NAME" ] || ! emulator -list-avds 2>/dev/null | grep -qx "$AVD_NAME"; then' \
        '    echo "ERROR: AVD не создан. Проверьте system-images." >&2' \
        '    emulator -list-avds >&2 2>&1 || true' \
        '    exit 1' \
        'fi' \
        '' \
        '# 9. Запуск adb-сервера ДО эмулятора, чтобы emulator сразу подхватил его.' \
        'ADB=/opt/android/platform-tools/adb' \
        'if [ -x "$ADB" ]; then' \
        '    "$ADB" kill-server 2>/dev/null || true' \
        '    "$ADB" start-server >&2 2>&1 || true' \
        'fi' \
        '' \
        '# 10. Запуск эмулятора в фоне (нужен для установки APK).' \
        'echo "Starting AVD: $AVD_NAME on DISPLAY=$DISPLAY (HOME=$HOME)" >&2' \
        'emulator -avd "$AVD_NAME" \' \
        '    -gpu swiftshader_indirect \' \
        '    -no-snapshot -no-audio -no-boot-anim \' \
        '    -netdelay none -netspeed full &' \
        'EMU_PID=$!' \
        '' \
        '# 11. Установка APK из /opt/extensions/, если есть.' \
        'if [ -x "$ADB" ]; then' \
        '    echo "Waiting for device (up to 180s)..." >&2' \
        '    "$ADB" wait-for-device 2>&1 || true' \
        '    BOOT=""' \
        '    for i in $(seq 1 60); do' \
        '        BOOT=$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d "\r" || true)' \
        '        [ "$BOOT" = "1" ] && break' \
        '        sleep 3' \
        '    done' \
        '    echo "sys.boot_completed=$BOOT" >&2' \
        '    shopt -s nullglob' \
        '    for apk in /opt/extensions/*.apk ; do' \
        '        echo "Installing: $apk" >&2' \
        '        "$ADB" install -r "$apk" >&2 2>&1 || echo "WARN: install failed: $apk" >&2' \
        '    done' \
        '    shopt -u nullglob' \
        '    # Опционально: запустить F-Droid после установки' \
        '    if "$ADB" shell pm list packages 2>/dev/null | grep -q "org.fdroid.fdroid" ; then' \
        '        echo "Launching F-Droid..." >&2' \
        '        "$ADB" shell monkey -p org.fdroid.fdroid -c android.intent.category.LAUNCHER 1 >&2 2>&1 || true' \
        '    fi' \
        'fi' \
        '' \
        '# 12. Ждём эмулятор (foreground).' \
        'wait $EMU_PID' \
        > /opt/start-x11-emulator.sh ; \
    chmod 755 /opt/start-x11-emulator.sh ; \
    head -25 /opt/start-x11-emulator.sh

