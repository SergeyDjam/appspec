# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder
ENV DEBIAN_FRONTEND=noninteractive

# --- минимум для magicpak --dynamic: cc + dlfcn.h.
# --- build-essential НЕ используем: он тянет manpages-dev, texinfo и т.п.
# --- binutils ставится первым: в trixie gcc-14 не имеет прямой
# --- зависимости от него (Debian #1113854).
RUN apt-get update && apt-get install -y --no-install-recommends \
{%- for t in build.tools %}
        {{ t }} \
{%- endfor %}
    && apt-get install -y --fix-broken \
    && apt-get install -y --no-install-recommends \
        gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

ARG SRC_URL={{ source_url }}

# --- Установка зависимостей .deb-пакета.
# --- apt-get satisfy понимает грамматику Depends, включая альтернативы
# --- 'A | B | C' — выбирает первую доступную в репозитории. apt-get install
# --- так не умеет: он видит '|' как отдельный аргумент и падает на
# --- последней альтернативе, которой может не быть.
# --- КАВЫЧКИ вокруг "$DEPS" — обязательны: без них shell режет по пробелам
# --- и apt снова получает мусор.
RUN wget -q -O /tmp/pkg.deb "$SRC_URL" \
    && DEPS=$(dpkg-deb -f /tmp/pkg.deb Depends | sed 's/ ([^)]*)//g') \
    && echo "--- DEPS: $DEPS" \
    && apt-get update \
    && apt-get satisfy -y --no-install-recommends "$DEPS" \
{%- if build.apt.extra %}
    && apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
           {{ p }} \
{%- endfor %}
{%- endif %}
    && dpkg-deb -x /tmp/pkg.deb / \
    && rm -f /tmp/pkg.deb

{% if binary -%}
RUN chmod +x {{ binary | sh_quote }} 2>/dev/null || true

{% endif -%}
# ========== Stage 2: collector (magicpak) ==========
FROM builder AS collector

RUN apt-get update && apt-get install -y --no-install-recommends \
        coreutils \
        xvfb \
        dbus \
        dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q \
        https://github.com/coord-e/magicpak/releases/download/{{ magicpak_version }}/magicpak-x86_64-unknown-linux-musl \
        -O /usr/bin/magicpak \
    && chmod +x /usr/bin/magicpak

ENV HOME=/tmp/app-home
ENV XDG_RUNTIME_DIR=/tmp/app-runtime
ENV XDG_CONFIG_HOME=/tmp/app-home/.config
ENV XDG_DATA_HOME=/tmp/app-home/.local/share
ENV XDG_CACHE_HOME=/tmp/app-home/.cache

# --- Список --include собирается через find -type f, чтобы каталоги
# --- попадали в бандл целиком (например, /usr/share/codium).
# --- Целевой процесс обёрнут внешним timeout: GUI не выходит сам.
RUN mkdir -p "$HOME" "$XDG_RUNTIME_DIR" /bundle \
    && chmod 700 "$XDG_RUNTIME_DIR" \
    && set +e \
    && echo "=== building include list ===" \
    && : > /tmp/includes.txt \
{%- for inc in build.collect.includes %}
    && for f in {{ inc }}; do \
           if [ -f "$f" ]; then \
               echo "$f" >> /tmp/includes.txt; \
           elif [ -d "$f" ]; then \
               find "$f" -type f >> /tmp/includes.txt; \
           fi; \
       done \
{%- endfor %}
    && set -- \
    && while IFS= read -r f; do set -- "$@" --include "$f"; done < /tmp/includes.txt \
    && echo "=== $# include arguments ===" \
    \
    && echo "=== pass 1: magicpak --dynamic under Xvfb ===" \
    && xvfb-run -a -s "-screen 0 1024x768x24" \
        timeout --signal=TERM --kill-after=10 {{ collect_timeout }} \
        magicpak --dynamic --verbose "$@" \
            {{ binary | sh_quote }} /bundle \
    ; rc=$? ; \
    echo "--- magicpak --dynamic exit=$rc ---" ; \
    ls -la /bundle 2>/dev/null || true ; \
    \
    if [ ! -d /bundle/usr ] && [ ! -d /bundle/lib ] && [ ! -d /bundle/lib64 ] && [ ! -d /bundle/bin ] ; then \
        echo "=== retry: magicpak --dynamic without Xvfb ===" ; \
        rm -rf /bundle && mkdir -p /bundle ; \
        timeout --signal=TERM --kill-after=10 {{ collect_timeout }} \
            magicpak --dynamic --verbose "$@" \
                {{ binary | sh_quote }} /bundle \
        ; rc=$? ; \
        echo "--- magicpak --dynamic (no Xvfb) exit=$rc ---" ; \
        ls -la /bundle 2>/dev/null || true ; \
        if [ ! -d /bundle/usr ] && [ ! -d /bundle/lib ] && [ ! -d /bundle/lib64 ] && [ ! -d /bundle/bin ] ; then \
            echo "magicpak produced no usable bundle" >&2 ; \
            exit 1 ; \
        fi ; \
    fi ; \
    exit 0

RUN mkdir -p /bundle/bin \
    && wget -q "{{ busybox_url }}" -O /bundle/bin/busybox \
    && chmod +x /bundle/bin/busybox \
    && cd /bundle/bin \
    && for applet in \
         sh ash cat cp mv rm mkdir rmdir ls ln chmod chown \
         id whoami sed awk grep egrep fgrep tr cut head tail \
         sort uniq tee echo printf sleep true false test env \
         printenv date hostname uname basename dirname readlink \
         realpath find xargs tar gzip gunzip touch stat du df ps kill; do \
         [ -e "./$applet" ] || ln -s busybox "./$applet" ; \
       done \
    && ls -la /bundle/bin/ | head -20

RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# ========== Stage 3: final scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}