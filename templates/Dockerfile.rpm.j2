# syntax=docker/dockerfile:1
# Auto-generated by appspec from {{ pkg.name }} {{ pkg.version }} — DO NOT EDIT
# Target: RPM-based distro (ROSA / ALT Linux / Fedora / RHEL)

# ========== Stage 1: builder ==========
FROM {{ build.base }} AS builder

# --- Выбор пакетного менеджера.
# ---   1. Явное [build].pkg_manager
# ---   2. [build].distro = "rosa" + [build].version (>=12 → dnf, <12 → urpmi)
# ---   3. Автоопределение по /etc/os-release
{% if build.pkg_manager is defined and build.pkg_manager %}
ENV PKG_MGR={{ build.pkg_manager }}
{% elif build.distro is defined and build.distro == "rosa" %}
ENV PKG_MGR={% if build.version is defined and build.version | int >= 12 %}dnf{% else %}urpmi{% endif %}
{% else %}
RUN if command -v dnf >/dev/null 2>&1; then echo "dnf" > /tmp/pkg_mgr; \
    elif command -v urpmi >/dev/null 2>&1; then echo "urpmi" > /tmp/pkg_mgr; \
    else echo "unknown" > /tmp/pkg_mgr; fi \
    && echo "detected package manager: $(cat /tmp/pkg_mgr)"
ENV PKG_MGR=$(cat /tmp/pkg_mgr)
{% endif %}

RUN set -e ; \
    if [ "$PKG_MGR" = "dnf" ]; then \
        dnf install -y --setopt=install_weak_deps=False \
            ca-certificates wget rpm-build binutils patchelf gcc gcc-c++ make glibc-devel cpio ; \
        dnf clean all ; \
    elif [ "$PKG_MGR" = "urpmi" ]; then \
        urpmi --auto \
            ca-certificates wget rpm-build binutils patchelf gcc gcc-c++ make glibc-devel cpio ; \
        urpmi --clean ; \
    elif [ "$PKG_MGR" = "apt-get" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            ca-certificates wget rpm-build binutils patchelf gcc g++ make glibc-devel cpio ; \
        apt-get clean ; \
    else \
        echo "unsupported package manager: $PKG_MGR" >&2 ; exit 1 ; \
    fi

ARG SRC_URL={{ source_url }}

RUN wget -q -O /tmp/pkg.rpm "$SRC_URL" \
    && mkdir -p /tmp/pkg-extract \
    && cd /tmp/pkg-extract \
    && rpm2cpio /tmp/pkg.rpm | cpio -idmv \
    && cp -a /tmp/pkg-extract/* / \
    && rm -rf /tmp/pkg-extract /tmp/pkg.rpm

{% if build.apt.extra -%}
RUN set -e ; \
    if [ "$PKG_MGR" = "dnf" ]; then \
        dnf install -y --setopt=install_weak_deps=False \
{%- for p in build.apt.extra %}
            {{ p }} \
{%- endfor %}
        && dnf clean all ; \
    elif [ "$PKG_MGR" = "urpmi" ]; then \
        urpmi --auto \
{%- for p in build.apt.extra %}
            {{ p }} \
{%- endfor %}
        && urpmi --clean ; \
    else \
        apt-get update && apt-get install -y --no-install-recommends \
{%- for p in build.apt.extra %}
            {{ p }} \
{%- endfor %}
        && apt-get clean ; \
    fi
{% endif -%}

{% if binary -%}
RUN chmod +x {{ binary | sh_quote }} 2>/dev/null || true

{% endif -%}
# ========== Stage 2: collector ==========
FROM builder AS collector

RUN set -e ; \
    if [ "$PKG_MGR" = "dnf" ]; then \
        dnf install -y --setopt=install_weak_deps=False \
            coreutils xorg-x11-server-Xvfb dbus dbus-x11 ; \
        dnf clean all ; \
    elif [ "$PKG_MGR" = "urpmi" ]; then \
        urpmi --auto coreutils xorg-x11-server-Xvfb dbus dbus-x11 ; \
        urpmi --clean ; \
    else \
        apt-get update && apt-get install -y --no-install-recommends \
            coreutils xvfb dbus dbus-x11 ; \
        apt-get clean ; \
    fi

RUN wget -q \
        https://github.com/coord-e/magicpak/releases/download/{{ magicpak_version }}/magicpak-x86_64-unknown-linux-musl \
        -O /usr/bin/magicpak \
    && chmod +x /usr/bin/magicpak

ENV HOME=/tmp/app-home
ENV XDG_RUNTIME_DIR=/tmp/app-runtime
ENV XDG_CONFIG_HOME=/tmp/app-home/.config
ENV XDG_DATA_HOME=/tmp/app-home/.local/share
ENV XDG_CACHE_HOME=/tmp/app-home/.cache

RUN mkdir -p "$HOME" "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR" \
    && set +e \
    && echo "=== building include list ===" \
    && set -- \
{%- for inc in build.collect.includes %}
    && for f in {{ inc }}; do if [ -f "$f" ]; then set -- "$@" --include "$f"; fi; done \
{%- endfor %}
    && echo "=== $# include arguments ===" \
    && echo "=== pass 1: magicpak --dynamic under Xvfb ===" \
    && xvfb-run -a -s "-screen 0 1024x768x24" \
        timeout --signal=TERM --kill-after=10 {{ collect_timeout }} \
        magicpak --dynamic --verbose "$@" \
            /usr/bin/timeout --signal=TERM --kill-after=2 15 \
                {{ binary | sh_quote }} /bundle \
    ; rc=$? ; \
    echo "--- magicpak --dynamic exit=$rc ---" ; \
    ls -la /bundle 2>/dev/null || true ; \
    if [ ! -d /bundle/usr ] && [ ! -d /bundle/lib ] && [ ! -d /bundle/lib64 ] && [ ! -d /bundle/bin ] ; then \
        echo "=== pass 2: fallback to static mode ===" ; \
        rm -rf /bundle ; \
        magicpak --verbose "$@" \
            {{ binary | sh_quote }} /bundle \
        ; rc=$? ; \
        echo "--- magicpak static exit=$rc ---" ; \
        ls -la /bundle 2>/dev/null || true ; \
        if [ ! -d /bundle/usr ] && [ ! -d /bundle/lib ] && [ ! -d /bundle/lib64 ] && [ ! -d /bundle/bin ] ; then \
            echo "magicpak produced no usable bundle in either mode" >&2 ; \
            exit 1 ; \
        fi ; \
    fi ; \
    exit 0

RUN mkdir -p /bundle/bin \
    && wget -q {{ busybox_url }} -O /bundle/bin/busybox \
    && chmod +x /bundle/bin/busybox \
    && /bundle/bin/busybox --install -s /bundle/bin/ \
    && ls -la /bundle/bin/ | head -20

# --- Apptainer startscript: если передана команда (`instance start … CMD`),
# --- выполняем её. Иначе — висим, чтобы instance жил.
RUN mkdir -p /bundle/.singularity.d/env \
    && printf '#!/bin/sh\nif [ "$#" -gt 0 ]; then exec "$@"; fi\nwhile true; do sleep 3600; done\n' \
         > /bundle/.singularity.d/startscript \
    && chmod 0755 /bundle/.singularity.d/startscript \
    && cp /bundle/.singularity.d/startscript /bundle/.singularity.d/runscript

# ========== Stage 3: scratch ==========
FROM scratch
COPY --from=collector /bundle /

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

{% for k, v in build.scratch.env | items -%}
ENV {{ k }}={{ v | docker_env }}
{% endfor -%}
{% if build.scratch.env -%}

{% endif -%}
WORKDIR {{ workdir }}
CMD {{ cmd | json_array }}