# =============================================================================
# appspec spec: podman (Alpine / daemonless container runtime)
# =============================================================================

[package]
name        = "podman"
version     = "5.3.1"
description = "Podman rootless runtime (Alpine, containerized)"

# -----------------------------------------------------------------------------
# build
# -----------------------------------------------------------------------------
[build]
base     = "alpine:3.24"
arch     = "amd64"
template = "alpine"

[build.source]
type = ""
url  = ""

[build.apt]
extra = [
    "podman",
    "podman-docker",         # /usr/bin/docker → podman
    "podman-compose",        # /usr/bin/podman-compose
    "crun",                  # реальный runtime
    "conmon",                # container monitor (не всегда тянется как зависимость)
    "fuse-overlayfs",
    "slirp4netns",
    "ca-certificates",
    "tzdata",
]

[build.collect]
binary       = "/usr/bin/podman"
timeout_secs = 10
busybox_url  = "https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox"

includes = [
    "/etc/ssl/certs/ca-certificates.crt",
    "/etc/containers",
    "/usr/share/containers",
]

[build.scratch]
workdir = "/work"
cmd     = ["/usr/bin/podman", "--version"]

[build.scratch.env]
LANG   = "C.UTF-8"
LC_ALL = "C.UTF-8"
HOME   = "/work"

# -----------------------------------------------------------------------------
# runtime — CLI mode
# -----------------------------------------------------------------------------
[runtime]
mode    = "cli"
command = "/usr/bin/podman"

sif_file   = "podman.sif"
image_name = "podman:latest"

env_passthrough = ["TERM", "XDG_RUNTIME_DIR"]

binds       = []
create_dirs = []

# -----------------------------------------------------------------------------
# install
# -----------------------------------------------------------------------------
[install]
scope         = "user"
launcher_name = "podman-container"
desktop       = false
comment       = "Podman (containerized, Alpine, rootless)"

extra_files = []