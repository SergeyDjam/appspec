# =============================================================================
# appspec bundle: vscodium + components + extensions
#
# Home наследуется из base-спека (vscodium.appspec):
#   CONFIG_DIR = "$HOME/vscodium_config"  →  ~/vscodium_config/home
# т.е. настройки переживают `appspec clean`.
#
# `[bundle.extensions]` не задан — используется default mount_dir
# (/config/home/.vscodium/extensions) и default install (нет install).
#
# Для type=vsix расширения распаковываются в каталоги
# <publisher>.<name>-<version>/ в $BUNDLE_DIR/extensions/, а этот каталог
# bind'ится в целевой --extensions-dir VSCodium. VSCodium подхватывает
# каталоги сам — codium --install-extension не нужен (и не работает
# без X-сервера).
# =============================================================================

[bundle]
name        = "vscodium-dev"
description = "VSCodium + git + offline/online extensions"
version     = "0.1.2"
strict      = false
base        = { spec = "./vscodium.appspec" }
aliases    = ["vscodium-bundle"]

# --- Компоненты --------------------------------------------------------

[[components]]
name    = "git"
spec    = "./git.appspec"
mount   = "/opt/utils/git"
provide = "git"
binary  = "%{_bindir}/git"
target  = "/usr/local/bin/git"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp", "SSH_AUTH_SOCK"]
forward = ["TERM", "LANG", "LC_ALL", "SSH_AUTH_SOCK"]

[components.env]
GIT_EXEC_PATH    = "/usr/libexec/git-core"
GIT_TEMPLATE_DIR = "/usr/share/git-core/templates"
GIT_SSH_COMMAND  = "ssh -o StrictHostKeyChecking=accept-new"

[components.selftest]
cmd             = ["git", "--version"]
expect_contains = "git version"

# --- extensions ---

[[extensions]]
name     = "opentofu"
file     = "./extensions/opentofu-0.6.3.vsix"
requires = ["opentofu"]

[[extensions]]
name = "gitlab-workflow"
url  = "https://gitlab.com/api/v4/projects/5261717/packages/generic/release/7.2.0/gitlab-workflow-7.2.0.vsix"

[[extensions]]
name     = "ms-azuretools.vscode-docker"
requires = ["podman", "podman-compose"]

[[extensions]]
name = "onnovalkering.vscode-singularity"

[[extensions]]
name = "maxking.forgejo-vscode"

[[extensions]]
name     = "bazz.uv-manager"
requires = ["uv"]

# --- kubectl ---

[[components]]
name    = "kubectl"
spec    = "./kubectl.appspec"
provide = "kubectl"
binary  = "%{_bindir}/kubectl"
target  = "/usr/local/bin/kubectl"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["kubectl", "version", "--client"]
expect_contains = "Client Version"

# --- uv ---

[[components]]
name    = "uv"
spec    = "./uv.appspec"
provide = "uv"
binary  = "/usr/local/bin/uv"
target  = "/usr/local/bin/uv"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["uv", "--version"]
expect_contains = "uv "

# ---- mkisofs -----

[[components]]
name    = "mkisofs"
spec    = "./mkisofs.appspec"
provide = "mkisofs"
mounts  = ["PWD", "HOME", "/tmp", "/proc", "/dev"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["mkisofs", "--version"]
expect_contains = "mkisofs"

# ---- opentofu -----

[[components]]
name    = "opentofu"
spec    = "./opentofu-libvirt.appspec"
provide = "opentofu"
binary  = "/usr/local/bin/tofu"
target  = "/usr/local/bin/tofu"
# exec: tofu запускается из своего rootfs, но в namespace base.
# Иначе его local-exec (ansible-playbook, qemu-img, ssh) оказывается
# в chroot без base-tools и без /opt/utils соседних компонентов.
bridge  = "exec"
mounts  = [
    "PWD", "HOME", "/proc", "/dev", "/tmp",
    "/etc/resolv.conf", "/etc/hosts",
]
forward = ["TERM", "LANG", "LC_ALL", "TF_LOG", "TF_LOG_PROVIDER",
           "TF_CLI_ARGS", "TF_DATA_DIR", "SSH_AUTH_SOCK"]

[components.selftest]
cmd             = ["tofu", "--version"]
expect_contains = "OpenTofu"

# --- ansible + ssh (отдельный компонент, не часть virt-daemon) ---

[[components]]
name    = "ansible"
spec    = "./ansible.appspec"
provide = "ansible-playbook"
binary  = "%{_bindir}/ansible-playbook"
target  = "/usr/local/bin/ansible-playbook"
bins = [
    "ansible",
    "ansible-galaxy",
    "ssh",
    { name = "bash", path = "/bin/bash" },
    "seq",
    "timeout",
]
mounts  = [
    "PWD", "HOME", "/proc", "/dev", "/tmp",
    "/etc/resolv.conf", "/etc/hosts",
]
forward = ["TERM", "LANG", "LC_ALL", "SSH_AUTH_SOCK"]

[components.env]
# В ansible-sandbox нет локалей хоста (ru_RU.UTF-8 и т.п.);
# без этого ansible-playbook падает: unsupported locale setting.
LANG   = "C.UTF-8"
LC_ALL = "C.UTF-8"

[components.selftest]
cmd             = ["ansible-playbook", "--version"]
expect_contains = "ansible-playbook"

# --- podman ---

[[components]]
name    = "podman"
spec    = "./podman.appspec"
provide = "podman"
mode    = "both"
contain = false
socket_dir = "$BUNDLE_DIR/run/podman"
state_dir  = "$BUNDLE_DIR/state/podman"
daemon        = "/opt/appspec/daemon.sh"
daemon_socket = "/srv/podman/podman.sock"
mounts  = ["/etc/resolv.conf", "/etc/hosts", "/srv/podman", "/proc", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.env]
CONTAINER_HOST                  = "unix:///srv/podman/podman.sock"
PODMAN_IGNORE_CGROUPSV1_WARNING = "1"

[[components.files]]
to    = "/opt/appspec/daemon.sh"
scope = "instance"
mode  = 0o755
content = """
#!/bin/sh
exec > /srv/podman/daemon.log 2>&1
set -x
unset CONTAINER_HOST DOCKER_HOST CONTAINER_CONNECTION CONTAINER_SSHKEY
mkdir -p /srv/podman /srv/podman/runtime /srv/podman/storage /srv/podman/run
export XDG_RUNTIME_DIR=/srv/podman/runtime
export XDG_DATA_HOME=/srv/podman/data
echo "=== env at daemon start ==="
env | sort
echo "=== which binaries ==="
command -v podman       || true
command -v conmon       || true
command -v crun         || true
command -v netavark     || true
command -v aardvark-dns || true
echo "=== starting podman system service ==="
podman system service --time=0 unix:///srv/podman/podman.sock
rc=$?
echo "=== podman system service exited with code $rc ==="
exit $rc
"""

[[components.files]]
to    = "/usr/local/bin/mkisofs"
scope = "sandbox"
mode  = 0o755
content = """
#!/bin/sh
SANDBOX=/opt/utils/mkisofs
[ -d "$SANDBOX" ] || { echo "mkisofs: $SANDBOX не смонтирован" >&2; exit 127; }
CWD="$(pwd -P)"
exec chroot --skip-chdir "$SANDBOX" /bin/sh -c '
    cd "$1" 2>/dev/null || cd /
    shift
    exec "$@"
' sh "$CWD" %{_bindir}/mkisofs "$@"
"""

[[components.files]]
to    = "/etc/containers/storage.conf"
scope = "instance"
content = """
[storage]
driver    = "overlay"
graphroot = "/srv/podman/storage"
runroot   = "/srv/podman/run"

[storage.options]
skip_mount_home = "true"

[storage.options.overlay]
ignore_chown_errors = "true"
"""

[[components.files]]
to    = "/etc/containers/storage.conf"
scope = "sandbox"
content = """
[storage]
driver    = "overlay"
graphroot = "/tmp/podman-cli-storage"
runroot   = "/tmp/podman-cli-run"

[storage.options]
skip_mount_home = "true"

[storage.options.overlay]
ignore_chown_errors = "true"
"""

[components.selftest]
cmd             = ["podman", "info"]
expect_contains = "graphDriverName"

# --- podman-compose ---

[[components]]
name    = "podman-compose"
spec    = "./podman.appspec"
mount   = "/opt/utils/podman-compose"
provide = "podman-compose"
binary  = "%{_bindir}/podman-compose"
target  = "/usr/local/bin/podman-compose"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["podman-compose", "version"]
expect_contains = "podman-compose"

# --- libvirtd ---

[[components]]
name    = "libvirtd"
spec    = "./virt-daemon.appspec"
mode    = "both"
provide = "libvirtd"
binary  = "/usr/sbin/libvirtd"
contain = false
socket_dir    = "$BUNDLE_DIR/run/libvirt"
daemon_socket = "/var/run/libvirt/libvirt-sock"
daemon        = "/opt/appspec/libvirtd-wrapper.sh"
# Инструменты из virt-daemon, которые нужны base/tofu. Bridge'и попадают
# в /opt/appspec/bin и доступны в том числе внутри chroot компонента opentofu.
# Если /dev/kvm на хосте не работает (VM без nested virtualization):
#   APPSPEC_DISABLE_KVM=1 appspec run examples/vscodium-bundle.appspec
bins = [
    "qemu-img",
    "qemu-system-x86_64",
    "cloud-localds",
]
mounts = [
    "/proc", "/sys/fs/cgroup", "/dev/kvm", "/dev/net/tun",
    "/etc/resolv.conf", "/etc/hosts", "/tmp",
]

[components.env]
LIBVIRT_DEBUG = "4"

[[components.files]]
to   = "/opt/appspec/libvirtd-wrapper.sh"
from = "./libvirtd-wrapper.sh"
scope = "instance"
mode  = 0o755