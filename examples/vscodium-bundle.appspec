[bundle]
name        = "vscodium-dev"
description = "VSCodium + git + offline/online extensions"
strict      = false
base        = { spec = "./vscodium.appspec" }

# --- Компоненты --------------------------------------------------------

[[components]]
name    = "git"
spec    = "./git.appspec"
mount   = "/opt/utils/git"
provide = "git"
binary  = "/usr/bin/git"
target  = "/usr/local/bin/git"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp", "SSH_AUTH_SOCK"]
forward = ["TERM", "LANG", "LC_ALL", "SSH_AUTH_SOCK"]

[components.env]
GIT_EXEC_PATH    = "/usr/libexec/git-core"
GIT_TEMPLATE_DIR = "/usr/share/git-core/templates"
GIT_SSH_COMMAND  = "ssh -o StrictHostKeyChecking=accept-new"

[components.selftest]
cmd             = ["git", "--version"]
expect_contains = "git version"

# --- extensions ---

[bundle.extensions]
mount_dir = "/opt/extensions"
install   = "$CODIUM --no-sandbox --disable-gpu --user-data-dir \"$HOME/.vscodium\" --extensions-dir \"$HOME/.vscodium/extensions\" --install-extension {target} --force"

[[extensions]]
name     = "opentofu"
file     = "./extensions/opentofu-0.6.3.vsix"
requires = ["opentofu", "tofu-ls"]

[[extensions]]
name = "gitlab-workflow"
url  = "https://gitlab.com/api/v4/projects/5261717/packages/generic/release/7.2.0/gitlab-workflow-7.2.0.vsix"

[[extensions]]
name     = "ms-azuretools.vscode-docker"
requires = ["podman", "podman-compose"]

[[extensions]]
name = "onnovalkering.vscode-singularity"

[[extensions]]
name = "maxking.forgejo-vscode"

[[extensions]]
name     = "bazz.uv-manager"
requires = ["uv"]

# --- kubectl ---

[[components]]
name    = "kubectl"
spec    = "./kubectl.appspec"
provide = "kubectl"
binary  = "/usr/bin/kubectl"
target  = "/usr/local/bin/kubectl"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["kubectl", "version", "--client"]
expect_contains = "Client Version"

# --- uv ---

[[components]]
name    = "uv"
spec    = "./uv.appspec"
provide = "uv"
binary  = "/usr/local/bin/uv"
target  = "/usr/local/bin/uv"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["uv", "--version"]
expect_contains = "uv "

# ---- mkisofs -----

[[components]]
name    = "mkisofs"
spec    = "./mkisofs.appspec"
provide = "mkisofs"
mounts  = ["PWD", "HOME", "/tmp", "/proc", "/dev"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["mkisofs", "--version"]
expect_contains = "mkisofs"

# ---- opentofu -----

[[components]]
name    = "opentofu"
spec    = "./opentofu.appspec"
provide = "opentofu"
binary  = "/usr/local/bin/tofu"
target  = "/usr/local/bin/tofu"
mounts  = [
    "PWD", "HOME", "/proc", "/dev", "/tmp",
    "/opt/utils/mkisofs",           # пробрасываем mkisofs-sandbox внутрь opentofu-sandbox
    "/var/run/libvirt/libvirt-sock",
    "/var/run/libvirt/libvirt-sock-ro",      # ← опционально: ro-сокет для virt-top и пр.
]
forward = ["TERM", "LANG", "LC_ALL", "TF_LOG", "TF_LOG_PROVIDER",
           "TF_CLI_ARGS", "TF_DATA_DIR", "SSH_AUTH_SOCK"]

# Wrapper: делает nested chroot в mkisofs-sandbox, чтобы tofu "увидел" mkisofs
[[components.files]]
to    = "/usr/local/bin/mkisofs"
scope = "sandbox"
mode  = 0o755
content = """
#!/bin/sh
# appspec: mkisofs из отдельного контейнера.
#
# Мы находимся в opentofu-sandbox'е. /opt/utils/mkisofs — bind на mkisofs-
# sandbox, но без submount'ов (opentofu получил его через --bind, а не --rbind).
# Поэтому /tmp, /proc, /dev, $HOME и $PWD внутри mkisofs-sandbox отсутствуют,
# и xorriso не может открыть /tmp/cloudinitXXX/cloudinit.iso.
#
# Восстанавливаем submount'ы здесь, перед chroot. --fakeroot даёт
# CAP_SYS_ADMIN в userns, mount --bind работает.

SANDBOX=/opt/utils/mkisofs
[ -d "$SANDBOX/usr/bin" ] || { echo "mkisofs: $SANDBOX не смонтирован" >&2; exit 127; }

# Пробрасываем «одноуровневые» пути, которые нужны xorriso.
for p in /tmp /proc /dev /sys /etc/resolv.conf /etc/hosts; do
    [ -e "$p" ] || continue
    tgt="$SANDBOX$p"
    mkdir -p "$(dirname "$tgt")" 2>/dev/null || true
    [ -e "$tgt" ] || { [ -d "$p" ] && mkdir -p "$tgt" || ( : > "$tgt" ); } 2>/dev/null || true
    /bin/busybox mountpoint -q "$tgt" 2>/dev/null && continue
    /bin/busybox mount --bind "$p" "$tgt" 2>/dev/null || true
done

# PWD и HOME — чтобы относительные пути и os.MkdirTemp были видны.
CWD="$(pwd -P)"
if [ "$CWD" != "/" ] && [ -e "$CWD" ]; then
    mkdir -p "$SANDBOX$CWD" 2>/dev/null || true
    /bin/busybox mount --bind "$CWD" "$SANDBOX$CWD" 2>/dev/null || true
fi
HOME_REAL="${HOME:-/config/home}"
if [ -e "$HOME_REAL" ]; then
    mkdir -p "$SANDBOX$HOME_REAL" 2>/dev/null || true
    /bin/busybox mount --bind "$HOME_REAL" "$SANDBOX$HOME_REAL" 2>/dev/null || true
fi

# Ищем реальный бинарь (cdrkit даёт mkisofs, xorriso даёт xorrisofs).
BIN=""
for c in /usr/bin/mkisofs /usr/bin/xorrisofs /usr/bin/genisoimage; do
    if [ -e "$SANDBOX$c" ]; then BIN="$c"; break; fi
done
[ -n "$BIN" ] || { echo "mkisofs: бинарь не найден в $SANDBOX" >&2; exit 127; }

exec /bin/busybox chroot "$SANDBOX" /bin/sh -c '
    cd "$1" 2>/dev/null || cd /
    shift
    exec "$@"
' sh "$CWD" "$BIN" "$@"
"""


[components.selftest]
cmd             = ["tofu", "--version"]
expect_contains = "OpenTofu"


# --- tofu-ls ---

[[components]]
name    = "tofu-ls"
spec    = "./tofu-ls.appspec"
provide = "tofu-ls"
binary  = "/usr/local/bin/tofu-ls"
target  = "/usr/local/bin/tofu-ls"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["tofu-ls", "--version"]
expect_contains = "tofu-ls"

# --- podman ---

[[components]]
name    = "podman"
spec    = "./podman.appspec"
provide = "podman"
mode    = "both"

contain = false

socket_dir = "$BUNDLE_DIR/run/podman"
state_dir  = "$BUNDLE_DIR/state/podman"

daemon        = "/opt/appspec/daemon.sh"
daemon_socket = "/srv/podman/podman.sock"

mounts  = [
    "/etc/resolv.conf", "/etc/hosts",
    "/srv/podman",
    "/proc", "/tmp",
]
forward = ["TERM", "LANG", "LC_ALL"]

[components.env]
CONTAINER_HOST                  = "unix:///srv/podman/podman.sock"
PODMAN_IGNORE_CGROUPSV1_WARNING = "1"

[[components.files]]
to    = "/opt/appspec/daemon.sh"
scope = "instance"
mode  = 0o755
content = """
#!/bin/sh
exec > /srv/podman/daemon.log 2>&1
set -x

unset CONTAINER_HOST DOCKER_HOST CONTAINER_CONNECTION CONTAINER_SSHKEY

mkdir -p /srv/podman /srv/podman/runtime /srv/podman/storage /srv/podman/run

export XDG_RUNTIME_DIR=/srv/podman/runtime
export XDG_DATA_HOME=/srv/podman/data

echo "=== env at daemon start ==="
env | sort
echo "=== which binaries ==="
command -v podman       || true
command -v conmon       || true
command -v crun         || true
command -v netavark     || true
command -v aardvark-dns || true
echo "=== starting podman system service ==="
podman system service --time=0 unix:///srv/podman/podman.sock
rc=$?
echo "=== podman system service exited with code $rc ==="
exit $rc
"""

[[components.files]]
to    = "/usr/local/bin/mkisofs"
scope = "sandbox"
mode  = 0o755
content = """
#!/bin/sh
# appspec wrapper: вызывает mkisofs из отдельного sandbox-а
SANDBOX=/opt/utils/mkisofs
[ -d "$SANDBOX" ] || { echo "mkisofs: $SANDBOX не смонтирован" >&2; exit 127; }
CWD="$(pwd -P)"
exec chroot --skip-chdir "$SANDBOX" /bin/sh -c '
    cd "$1" 2>/dev/null || cd /
    shift
    exec "$@"
' sh "$CWD" /usr/bin/mkisofs "$@"
"""


[[components.files]]
to    = "/etc/containers/storage.conf"
scope = "instance"
content = """
[storage]
driver    = "overlay"
graphroot = "/srv/podman/storage"
runroot   = "/srv/podman/run"

[storage.options]
skip_mount_home = "true"

[storage.options.overlay]
ignore_chown_errors = "true"
"""

[[components.files]]
to    = "/etc/containers/storage.conf"
scope = "sandbox"
content = """
[storage]
driver    = "overlay"
graphroot = "/tmp/podman-cli-storage"
runroot   = "/tmp/podman-cli-run"

[storage.options]
skip_mount_home = "true"

[storage.options.overlay]
ignore_chown_errors = "true"
"""

[components.selftest]
cmd             = ["podman", "info"]
expect_contains = "graphDriverName"

# --- podman-compose ---
# Требуется расширением ms-azuretools.vscode-docker. Использует тот же SIF,
# что и podman, но отдельный sandbox — двойной расход диска (~100 МБ).
# Если это нежелательно, убери "podman-compose" из requires расширения выше.

[[components]]
name    = "podman-compose"
spec    = "./podman.appspec"
mount   = "/opt/utils/podman-compose"
provide = "podman-compose"
binary  = "/usr/bin/podman-compose"
target  = "/usr/local/bin/podman-compose"
mounts  = ["PWD", "HOME", "/proc", "/dev", "/tmp"]
forward = ["TERM", "LANG", "LC_ALL"]

[components.selftest]
cmd             = ["podman-compose", "version"]
expect_contains = "podman-compose"