# =============================================================================
# appspec spec: wireguard (userspace, wireguard-go)
# Конфиг строго монтируется с хоста. Требует запуска с --fakeroot --net.
# =============================================================================

[package]
name    = "wireguard"
version = "1.0.20260221"   # версия wireguard-tools в Alpine 3.24

release     = "1"
epoch       = 0
summary     = "WireGuard VPN (userspace wireguard-go)"
description = """
WireGuard — современный VPN-туннель. В контейнере используется userspace-
реализация wireguard-go, не требующая модуля ядра на хосте. Конфигурация
монтируется с хоста в режиме read-only.
"""
license  = "GPL-2.0"
url      = "https://www.wireguard.com"
vendor   = "WireGuard project"
packager = "appspec <appspec@example.invalid>"
bin      = "wg-quick"

# -----------------------------------------------------------------------------
# build
# -----------------------------------------------------------------------------
[build]
base     = "alpine:3.24"
arch     = "amd64"
template = "alpine"          # apk --root: ставит wireguard-tools, wireguard-go, bash

[build.apt]
extra = [
    "wireguard-tools",        # wg, wg-quick
    "wireguard-go",           # userspace-реализация
    "bash",                   # wg-quick требует bash
    "iproute2",               # ip link, ip addr
    "iptables",               # wg-quick для kill-switch (если есть в конфиге)
    "openresolv",             # resolvconf для DNS из wg-quick
    "procps",                 # pgrep/pkill (на всякий случай)
]

[build.collect]
binary = "/usr/bin/wg-quick"

[build.scratch]
workdir = "/etc/wireguard"
cmd     = ["/usr/bin/wg", "--version"]

[build.scratch.env]
LANG   = "C.UTF-8"
LC_ALL = "C.UTF-8"

# -----------------------------------------------------------------------------
# runtime — instance (VPN должен жить после выхода лаунчера)
# -----------------------------------------------------------------------------
[runtime]
mode    = "instance"
persist = true               # instance остаётся после завершения лаунчера
workdir = "/etc/wireguard"

sif_file   = "wireguard.sif"
image_name = "%{name}:%{version}"

# Переменные для пути к конфигу и имени интерфейса.
env_passthrough = ["TERM", "WIREGUARD_CONFIG", "WIREGUARD_INTERFACE"]

# Строгое монтирование конфига с хоста. Путь по умолчанию — /etc/wireguard/wg0.conf.
# Переопределяется через переменную WIREGUARD_CONFIG на хосте.
binds = [
    "${WIREGUARD_CONFIG:-/etc/wireguard/wg0.conf}:/etc/wireguard/wg0.conf:ro",
    "/dev/net/tun:/dev/net/tun",
]

# Каталог для runtime-файлов (создаётся на хосте).
create_dirs = ["$HOME/.local/share/appspec/wireguard"]

# setup выполняется внутри instance после старта. Запускаем wireguard-go
# в фоне, ждём появления интерфейса, применяем конфиг, поднимаем линк.
setup = """
set -eu
IFACE="${WIREGUARD_INTERFACE:-wg0}"

# userspace-реализация: wireguard-go создаёт TUN-интерфейс.
wireguard-go "$IFACE" &
WG_PID=$!

# Ждём, пока интерфейс появится (до 10 секунд).
for i in $(seq 1 20); do
    ip link show "$IFACE" >/dev/null 2>&1 && break
    sleep 0.5
done

if ! ip link show "$IFACE" >/dev/null 2>&1; then
    echo "FATAL: интерфейс $IFACE не создан wireguard-go" >&2
    kill "$WG_PID" 2>/dev/null || true
    exit 1
fi

# Применяем конфиг (файл смонтирован read-only).
wg setconf "$IFACE" /etc/wireguard/wg0.conf

# Поднимаем линк и назначаем адреса из конфига (wg-quick делает это сам,
# но мы используем userspace-реализацию и настраиваем вручную).
ip link set "$IFACE" up

# Адреса и маршруты берём из конфига через wg-quick (парсинг).
# Проще: выполнить wg-quick up, который сам всё сделает, включая
# userspace fallback (Alpine wg-quick умеет это из коробки).
# Но чтобы не зависеть от деталей реализации, оставляем ручную настройку.
# Для полноценного DNS/kill-switch используйте wg-quick.
"""

# entry не нужен: instance уже работает, setup выполнил настройку.
# Для остановки — appspec stop <spec>.
entry = ""

[install]
scope         = "user"
launcher_name = "wireguard-container"
desktop       = false
comment       = "WireGuard VPN (userspace, containerized)"
extra_files   = []