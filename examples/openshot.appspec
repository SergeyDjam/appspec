# =============================================================================
# appspec spec: openshot
# Видеоредактор OpenShot (версия из Debian Trixie-backports).
# =============================================================================

[package]
name    = "openshot"
version = "3.4.0"

release     = "1"
epoch       = 0
summary     = "OpenShot video editor (Qt GUI, MLT/FFmpeg backend)"
description = """
OpenShot — свободный нелинейный видеоредактор. Поддерживает множество
форматов через FFmpeg, работу с несколькими дорожками, ключевые кадры,
эффекты и анимацию. Интерфейс на Qt, ядро обработки — libopenshot (C++).
"""
license  = "GPL-3.0-or-later"
url      = "https://www.openshot.org"
vendor   = "OpenShot Studios, LLC"
packager = "appspec <appspec@example.invalid>"
bin      = "openshot-qt"

# -----------------------------------------------------------------------------
# build
# -----------------------------------------------------------------------------
[build]
base     = "debian:trixie"
arch     = "amd64"
template = "full"

[build.source]
type = ""
url  = ""

[build.apt]
extra = [
    # --- Основной пакет (из backports) ---
    "openshot-qt",
    # --- Runtime-зависимости (подтянутся автоматически, но фиксируем явно) ---
    "python3-openshot",
    "libopenshot-audio9",
    "libopenshot28",
    "python3-pyqt5",
    "python3-pyqt5.qtsvg",
    "python3-pyqt5.qtwebengine",
    "ffmpeg",
    "libmlt7",
    "libmlt-data",
    "frei0r-plugins",
    # --- Qt / GUI ---
    "libqt5core5a",
    "libqt5gui5",
    "libqt5widgets5",
    "libqt5svg5",
    "libqt5webengine5",
    "libx11-6",
    "libgl1",
    # --- Утилиты и шрифты ---
    "ca-certificates",
    "fonts-dejavu-core",
    "fonts-liberation",
    "dbus",
    "dbus-x11",
    "procps",
    "psmisc",
]

[build.collect]
binary = "%{_prefix}/bin/%{bin}"

[build.scratch]
workdir = "/config/home"
cmd     = ["%{_prefix}/bin/%{bin}"]

[build.scratch.env]
LANG   = "C.UTF-8"
LC_ALL = "C.UTF-8"
HOME   = "/config/home"

# -----------------------------------------------------------------------------
# runtime — GUI (instance)
# -----------------------------------------------------------------------------
[runtime]
sif_file   = "openshot.sif"
image_name = "openshot:latest"
template   = "default"
mode       = "instance"
persist    = false
workdir    = "/config/home"

env_passthrough = [
    "DISPLAY",
    "XAUTHORITY",
    "XDG_RUNTIME_DIR",
    "DBUS_SESSION_BUS_ADDRESS",
]

xauthority_auto = false
pulse_auto      = true

state_dirs = ["home", "log"]

create_dirs = [
    "$CONFIG_DIR/home/.config/openshot_qt",
    "$CONFIG_DIR/home/.local/share/openshot",
]

binds = [
    "/tmp/.X11-unix:/tmp/.X11-unix",
    "$XDG_RUNTIME_DIR/bus:$XDG_RUNTIME_DIR/bus",
    "$CONFIG_DIR/home:/config/home",
    "$CONFIG_DIR/log:/config/log",
]

optional_binds = [
    "/dev/dri:/dev/dri",
    "/dev/snd:/dev/snd",
]

setup = """
export HOME=/config/home
mkdir -p "$HOME/.config/openshot_qt" "$HOME/.local/share/openshot" \
         "$HOME/.cache/openshot_qt" 2>/dev/null || true

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u 2>/dev/null || echo 1000)}"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$HOME/.config/bus"
    dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork 2>/dev/null || true
fi

export LANG=C.UTF-8
export LC_ALL=C.UTF-8
"""

entry = 'exec %{_prefix}/bin/%{bin} "$@"'

[runtime.vars]
CONFIG_DIR = "$HOME/openshot_config"

# -----------------------------------------------------------------------------
# install
# -----------------------------------------------------------------------------
[install]
scope         = "user"
launcher_name = "openshot-container"
desktop       = true
categories    = ["AudioVideo", "Video", "Editor"]
comment       = "OpenShot video editor (containerized)"
wm_class      = "openshot-qt"
icon          = "icons/openshot.png"
extra_files   = []